---
import Base from '../layouts/Base.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import Split from '../components/Split.astro';
import MissionRail from '../components/MissionRail.astro';
import NightStory from '../components/NightStory.astro';
import Reviews from '../components/Reviews.astro';
import faq from '../data/faq.json';
import site from '../data/site.json';
import pricing from '../data/pricing.json';
import reviews from '../data/reviews.json';
import { getTours, yen } from '../lib/tours';
const tours = await getTours();

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'TravelAgency', name: site.name, url: Astro.site?.toString(), description: site.description, sameAs: [site.instagram, site.tiktok] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];

const slides = [
  { src: '/images/hero/secret-torii.webp', mobile: '/images/hero/secret-torii-m.webp', alt: 'A Ninja guide holding a paper lantern in a tunnel of red torii gates', caption: 'A hidden shrine · Shinjuku' },
  { src: '/images/hero/gyoen-smiles.webp', mobile: '/images/hero/gyoen-smiles-m.webp', alt: 'Three smiling guests with their Ninja guide at the gate of Shinjuku Gyoen', caption: 'Shinjuku Gyoen' },
  { src: '/images/hero/goldengai-night.webp', mobile: '/images/hero/goldengai-night-m.webp', alt: 'Two guests and their Ninja guide smiling under the neon of Kabukicho at night', caption: 'Kabukicho · Shinjuku' },
];

const places = [['SHINJUKU', '新宿'], ['GOLDEN GAI', 'ゴールデン街'], ['KABUKICHO', '歌舞伎町'], ['UENO', '上野'], ['ASAKUSA', '浅草'], ['KAPPABASHI', '合羽橋']];

// A real evening on the Secret Shrine & Golden Gai tours, told step by step
const night = [
  { kicker: '18:00 · 集合', title: 'Meet your Ninja under Godzilla', text: 'Your guide waits at the Godzilla Head. One step through the red arch of Kabukicho and the adventure begins.', image: '/images/tours/shinjuku-secret-shrine/story-1.webp', alt: 'The red Kabukicho Ichibangai arch above a busy street' },
  { kicker: '18:15 · 秘境', title: 'A shrine hidden behind the neon', text: 'The noise falls away. Pour water on the Frog Stone and wish for good fortune to return.', image: '/images/tours/shinjuku-secret-shrine/story-2.webp', alt: 'A Ninja guide with a lantern in a tunnel of red torii gates' },
  { kicker: '18:30 · 路地', title: 'Slip into Golden Gai', text: '280+ tiny bars packed into narrow lanes. Learn to read the signs and find the doors that welcome you.', image: '/images/tours/goldengai-nightlife/story-2.webp', alt: 'Colorful bar signboards crowding a narrow Golden Gai alley' },
  { kicker: '18:45 · 参拝', title: 'Make a wish at Hanazono Shrine', text: 'Bow, clap and pray with the guardian of Shinjuku’s entertainers, step by step with your guide.', image: '/images/tours/goldengai-nightlife/story-3.webp', alt: 'Hanazono Shrine lit up at night' },
  { kicker: '19:00 · 乾杯', title: 'Your night is just getting started', text: 'Photos with Godzilla, then your guide’s personal picks for dinner and drinks nearby.', image: '/images/tours/goldengai-nightlife/story-4.webp', alt: 'Guests posing with their Ninja guide under Kabukicho neon' },
];

const google = reviews.ratings.find((r) => r.source === 'Google');
---
<Base jsonLd={jsonLd} image="/images/og.jpg" overlayHeader>
  <!-- First visit only: sliding doors open onto Tokyo -->
  <script is:inline>
    try {
      if (!sessionStorage.getItem('ngt-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('intro');
        sessionStorage.setItem('ngt-intro', '1');
      }
    } catch (e) {}
  </script>
  <div class="curtain" aria-hidden="true">
    <div class="curtain__door curtain__door--l"></div>
    <div class="curtain__door curtain__door--r"></div>
    <span class="curtain__seal">忍</span>
  </div>

  <section class="hero">
    <HeroSlideshow slides={slides} />
    <div class="hero__shade" aria-hidden="true"></div>
    <p class="hero__vertical outline" aria-hidden="true">忍者と歩く、東京の裏側。</p>
    <div class="wrap hero__in">
      <p class="hero__kicker"><span class="jp">ようこそ</span> Private walking tours · Tokyo</p>
      <Split as="h1" class="hero__title" text="Walk Tokyo’s | *hidden side* | with a Ninja." delay={900} />
      <p class="hero__lead">Hidden shrines, tiny bars and neon alleys, explored in 60 minutes with a local friend. Just you and your group.</p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="#missions" data-track="click_hero_cta">Choose your mission</a>
        <a class="hero__play" href="#night"><span class="hero__shuriken" aria-hidden="true">✦</span> See a night with us</a>
      </div>
      <div class="hero__talk" aria-hidden="true">
        <p class="bubble bubble--guest">Where do locals actually go?</p>
        <p class="bubble bubble--ninja">Follow me. There’s a shrine hidden behind the neon! ⛩️</p>
      </div>
    </div>
    <a class="hero__scroll" href="#missions" aria-label="Scroll to tours"><span></span></a>
  </section>

  <div class="band marquee" aria-hidden="true" style="--speed:42s">
    <div class="marquee__track">
      {[0, 1].map(() => places.map(([en, jp]) => <span class="band__item">{en} <em>{jp}</em> <b>✦</b></span>))}
    </div>
  </div>

  <section class="section missions" id="missions">
    <div class="wrap missions__head">
      <div>
        <p class="eyebrow"><span class="jp">ツアー</span> Choose your mission</p>
        <Split text={`${tours.length} ways to | see Tokyo differently`} />
      </div>
      <p class="lead">Every tour is about 60 minutes, private for your group, and led by an English-speaking local guide.</p>
    </div>
    <MissionRail tours={tours} />
  </section>

  <section class="stats" aria-label="NINJA GO TOURS in numbers">
    <div class="wrap stats__grid">
      <div data-reveal><strong><span data-count="280">0</span>+</strong><span>tiny bars in Golden Gai</span></div>
      <div data-reveal style="--d:100ms"><strong><span data-count="60">0</span></strong><span>minutes, no rush</span></div>
      {google && <div data-reveal style="--d:200ms"><strong><span data-count={google.score.toFixed(1)}>0</span>★</strong><span>on Google ({google.count} reviews)</span></div>}
      <div data-reveal style="--d:300ms"><strong><span data-count="1">0</span></strong><span>guide just for your group</span></div>
    </div>
  </section>

  <section class="section section--dark night" id="night">
    <div class="wrap">
      <p class="eyebrow"><span class="jp">一夜の物語</span> A night with your Ninja</p>
      <Split text="What 60 minutes | in Shinjuku feels like" />
      <NightStory steps={night} />
      <p class="night__note">Based on the <a href="/tour/shinjuku-secret-shrine">Secret Shrine</a> and <a href="/tour/goldengai-nightlife">Golden Gai</a> tours. Times are an example.</p>
    </div>
  </section>

  <Reviews />

  <section class="section price" id="pricing">
    <div class="wrap">
      <p class="eyebrow"><span class="jp">料金</span> Group pricing</p>
      <Split text="Bring friends. | Pay less each." />
      <p class="lead">Your guide is yours alone, so the price per person drops as your group grows. Kids 12 and under join free with an adult.</p>
      <ul class="stamps">
        {pricing.tiers.map((t, i) => (
          <li class="stamp" data-stamp style={`--d:${i * 140}ms; --r:${[-8, 5, -4, 7][i]}deg`}>
            <span class="stamp__who">{t.label}</span>
            <strong>{yen(t.pricePerPerson)}</strong>
            <span class="stamp__per">per adult</span>
          </li>
        ))}
      </ul>
      <p class="price__note">{pricing.note} Some tours add a small materials fee. The E-Scooter tour has its own flat price.</p>
    </div>
  </section>

  <section class="section section--paper2 how">
    <div class="wrap">
      <p class="eyebrow"><span class="jp">流れ</span> How it works</p>
      <Split text="Three steps to your adventure" />
      <ol class="how__steps">
        <li data-reveal><span class="how__n" aria-hidden="true">一</span><strong>Pick a mission</strong><p>Choose a neighborhood and a theme you love.</p></li>
        <li data-reveal style="--d:120ms"><span class="how__n" aria-hidden="true">二</span><strong>Book in minutes</strong><p>Choose a date and time online and get instant confirmation by email.</p></li>
        <li data-reveal style="--d:240ms"><span class="how__n" aria-hidden="true">三</span><strong>Meet your Ninja</strong><p>Say “Konnichiwa!” at the meeting point and start exploring together.</p></li>
      </ol>
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="wrap">
      <p class="eyebrow"><span class="jp">よくある質問</span> FAQ</p>
      <h2>Good to know</h2>
      <div class="faq__list">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="go">
    <img class="go__img" src="/images/hero/secret-torii.webp" srcset="/images/hero/secret-torii-640.webp 640w, /images/hero/secret-torii-1024.webp 1024w, /images/hero/secret-torii.webp 2000w" sizes="100vw" alt="" loading="lazy" width="2000" height="1125" />
    <p class="go__vertical" aria-hidden="true">いざ、出発。</p>
    <div class="wrap go__in">
      <Split text="Your Ninja | is waiting." />
      <a class="btn btn--primary btn--lg" href="#missions" data-track="click_final_cta">Choose your mission</a>
    </div>
  </section>
</Base>

<style>
  /* Sliding-door intro (first visit only) */
  .curtain { display: none; }
  :global(html.intro) .curtain { display: block; position: fixed; inset: 0; z-index: 100; pointer-events: none; }
  .curtain__door { position: absolute; top: 0; bottom: 0; width: 50.5%; background: var(--night) var(--seigaiha); animation: door 1s cubic-bezier(.7,0,.2,1) 0.55s forwards; }
  .curtain__door--l { left: 0; border-right: 3px solid var(--shu); }
  .curtain__door--r { right: 0; border-left: 3px solid var(--shu); --dir: 1; }
  .curtain__door--l { --dir: -1; }
  @keyframes door { to { transform: translateX(calc(var(--dir) * 101%)); } }
  .curtain__seal { position: absolute; left: 50%; top: 50%; width: 96px; height: 96px; margin: -48px 0 0 -48px; border-radius: 18px; background: var(--shu); color: #fff; font-family: var(--display); font-size: 3.4rem; display: grid; place-items: center; animation: seal 1.1s ease forwards; }
  @keyframes seal { 0% { transform: scale(1.8) rotate(-20deg); opacity: 0; } 25% { transform: scale(1) rotate(-6deg); opacity: 1; } 60% { opacity: 1; } 100% { transform: scale(0.6) rotate(-6deg); opacity: 0; } }

  /* Hero */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; color: #fff; overflow: hidden; }
  .hero__shade { position: absolute; inset: 0; background: radial-gradient(ellipse 75% 70% at 0% 100%, rgb(8 8 18 / 0.9) 0%, rgb(8 8 18 / 0.55) 45%, rgb(8 8 18 / 0) 80%), linear-gradient(0deg, rgb(8 8 18 / 0.6), rgb(8 8 18 / 0) 40%), linear-gradient(180deg, rgb(8 8 18 / 0.45), rgb(8 8 18 / 0) 25%); }
  .hero__vertical { position: absolute; right: 3vw; top: 12vh; margin: 0; writing-mode: vertical-rl; font-family: var(--display); font-size: clamp(2.4rem, 5.2vw, 5rem); line-height: 1.1; color: rgb(255 255 255 / 0.55); letter-spacing: 0.08em; animation: fade-in 1.4s ease 1.2s both; }
  @keyframes fade-in { from { opacity: 0; transform: translateY(-20px); } }
  .hero__in { position: relative; width: 100%; padding-top: 120px; padding-bottom: 72px; }
  .hero__kicker { display: flex; flex-wrap: wrap; gap: 0.2em 0.7em; align-items: baseline; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--lantern); margin-bottom: 0.8em; }
  .hero__kicker .jp { font-weight: 800; color: #fff; letter-spacing: 0.25em; font-size: 1rem; }
  .hero :global(.hero__title) { font-size: clamp(2.8rem, 8.4vw, 7.4rem); line-height: 0.98; letter-spacing: -0.01em; margin-bottom: 0.3em; text-shadow: 0 4px 40px rgb(0 0 0 / 0.35); }
  .hero :global(.hero__title em) { font-style: normal; color: var(--lantern); }
  .hero__lead { font-size: clamp(1rem, 1.5vw, 1.2rem); max-width: 30em; color: rgb(255 255 255 / 0.88); animation: fade-in 1s ease 1.5s both; }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 22px; animation: fade-in 1s ease 1.7s both; }
  .btn--lg { padding: 1.05em 1.9em; font-size: 1.1rem; }
  .hero__play { color: #fff; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; }
  .hero__shuriken { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--lantern); color: var(--lantern); animation: spin 6s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .hero__talk { position: absolute; right: 16px; bottom: 90px; width: min(330px, 30vw); display: flex; flex-direction: column; gap: 10px; }
  .bubble { margin: 0; padding: 12px 16px; border-radius: 18px; font-size: 0.95rem; line-height: 1.4; box-shadow: 0 8px 24px rgb(0 0 0 / 0.3); animation: pop 0.6s both; }
  .bubble--guest { background: rgb(255 255 255 / 0.95); color: var(--ink); border-bottom-left-radius: 4px; margin-right: 40px; animation-delay: 2.4s; }
  .bubble--ninja { background: var(--shu); color: #fff; border-bottom-right-radius: 4px; margin-left: 40px; animation-delay: 3.4s; }
  @keyframes pop { from { opacity: 0; transform: translateY(12px) scale(0.95); } to { opacity: 1; transform: none; } }
  .hero__scroll { position: absolute; left: 50%; bottom: 18px; width: 26px; height: 42px; margin-left: -13px; border: 2px solid rgb(255 255 255 / 0.7); border-radius: 14px; }
  .hero__scroll span { position: absolute; left: 50%; top: 8px; width: 4px; height: 8px; margin-left: -2px; border-radius: 2px; background: #fff; animation: scroll-dot 1.8s ease-in-out infinite; }
  @keyframes scroll-dot { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }

  /* Marquee band */
  .band { background: var(--shu); color: #fff; padding: 18px 0; transform: rotate(-1.2deg); margin: -14px -2vw 0; position: relative; z-index: 2; box-shadow: 0 10px 30px rgb(0 0 0 / 0.25); }
  .band__item { font-family: var(--display); font-size: clamp(1.6rem, 3vw, 2.4rem); padding-right: 1.2em; }
  .band__item em { font-style: normal; color: var(--night); margin-left: 0.3em; }
  .band__item b { font-weight: 400; color: var(--lantern); margin-left: 1.2em; }

  /* Missions */
  .missions { overflow: hidden; }
  .missions__head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px 48px; align-items: end; margin-bottom: 24px; }
  .missions__head :global(h2), .night :global(h2), .price :global(h2), .how :global(h2) { font-size: clamp(2rem, 4.8vw, 3.6rem); line-height: 1.05; }

  /* Stats */
  .stats { background: var(--night); color: var(--cream); padding: 48px 0; border-top: 1px solid var(--night-3); }
  .stats__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .stats__grid div { display: flex; flex-direction: column; gap: 6px; border-left: 3px solid var(--shu); padding-left: 16px; }
  .stats__grid strong { font-family: var(--display); font-weight: 400; font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1; color: var(--lantern); }
  .stats__grid span { color: #cfc6b6; font-size: 0.95rem; }

  /* Night story */
  .night { padding-bottom: 80px; }
  .night__note { margin-top: 32px; font-size: 0.85rem; color: rgb(247 240 227 / 0.6); }
  .night__note a { color: var(--lantern); }

  /* Price stamps */
  .stamps { list-style: none; padding: 0; margin: 32px 0 20px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .stamp { aspect-ratio: 1; border-radius: 50%; border: 5px double var(--shu); color: var(--shu); display: grid; place-content: center; text-align: center; gap: 4px; background: radial-gradient(circle, rgb(226 70 43 / 0.06), rgb(226 70 43 / 0.02)); }
  .stamp strong { font-family: var(--display); font-weight: 400; font-size: clamp(1.6rem, 3.2vw, 2.6rem); line-height: 1; }
  .stamp__who { font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.8rem; }
  .stamp__per { font-size: 0.8rem; opacity: 0.8; }
  .stamp:last-child { background: var(--shu); color: #fff; }
  .price__note { color: var(--muted); font-size: 0.9rem; }

  /* How */
  .how__steps { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .how__steps li { background: var(--card); border-radius: var(--radius); padding: 26px; box-shadow: var(--shadow); }
  .how__n { display: block; font-family: var(--display); font-size: 3.4rem; color: var(--shu); line-height: 1; margin-bottom: 12px; }
  .how__steps strong { font-size: 1.15rem; }
  .how__steps p { margin: 0.4em 0 0; color: var(--muted); }

  /* FAQ */
  .faq__list { max-width: 760px; }
  .faq details { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 14px 18px; margin-bottom: 10px; }
  .faq summary { font-weight: 700; cursor: pointer; }
  .faq details p { margin: 0.6em 0 0; color: var(--muted); }

  /* Final CTA */
  .go { position: relative; min-height: 80svh; display: grid; align-items: center; color: #fff; overflow: hidden; background: var(--night); }
  .go__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; }
  .go::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(8 8 18 / 0.85), rgb(8 8 18 / 0.1)); }
  .go__vertical { position: absolute; z-index: 1; right: 5vw; top: 50%; transform: translateY(-50%); margin: 0; writing-mode: vertical-rl; font-family: var(--display); font-size: clamp(3rem, 7vw, 6.5rem); color: var(--lantern); text-shadow: 0 6px 40px rgb(0 0 0 / 0.5); }
  .go__in { position: relative; z-index: 1; }
  .go :global(h2) { font-size: clamp(2.4rem, 5.6vw, 5rem); line-height: 1; margin-bottom: 0.5em; max-width: 9em; }
  @supports (animation-timeline: view()) {
    .go__img { animation: go-pan linear both; animation-timeline: view(); }
    @keyframes go-pan { from { transform: scale(1.25) translateY(-6%); } to { transform: scale(1.05) translateY(6%); } }
  }

  @media (max-width: 900px) {
    .hero__talk { display: none; }
    .missions__head { grid-template-columns: 1fr; }
    .stats__grid { grid-template-columns: repeat(2, 1fr); }
    .stamps { grid-template-columns: repeat(2, 1fr); }
    .how__steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .hero__vertical { font-size: 1.9rem; top: 84px; right: 12px; color: rgb(255 255 255 / 0.4); }
    .hero__shade { background: linear-gradient(0deg, rgb(8 8 18 / 0.95) 0%, rgb(8 8 18 / 0.6) 42%, rgb(8 8 18 / 0) 70%), linear-gradient(180deg, rgb(8 8 18 / 0.5), rgb(8 8 18 / 0) 25%); }
    .hero__in { padding-bottom: 64px; }
    .hero__cta .btn { width: 100%; }
    .go { align-items: end; padding-bottom: 56px; }
    .go__vertical { position: relative; z-index: 1; writing-mode: horizontal-tb; transform: none; top: auto; right: auto; font-size: 2rem; padding: 0 16px; align-self: end; margin-top: 40vh; }
  }
  /* Returning visitors skip the intro, so start the hero animations sooner */
  :global(html:not(.intro)) .hero :global(.hero__title) { --d0: 120ms !important; }
  :global(html:not(.intro)) .hero__lead { animation-delay: 0.6s; }
  :global(html:not(.intro)) .hero__cta { animation-delay: 0.8s; }
  :global(html:not(.intro)) .hero__vertical { animation-delay: 0.4s; }
  @media (prefers-reduced-motion: reduce) {
    .hero__vertical, .hero__lead, .hero__cta, .bubble, .hero__shuriken, .hero__scroll span { animation: none; }
  }
</style>
