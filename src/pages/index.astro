---
import Usd from '../components/Usd.astro';
import NextStep from '../components/NextStep.astro';
import Base from '../layouts/Base.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import Split from '../components/Split.astro';
import MissionRail from '../components/MissionRail.astro';
import Emaki from '../components/Emaki.astro';
import Mist from '../components/Mist.astro';
import NinjaQuiz from '../components/NinjaQuiz.astro';
import TokyoMap from '../components/TokyoMap.astro';
import ProducedBy from '../components/ProducedBy.astro';
import Reviews from '../components/Reviews.astro';
import Icon from '../components/Icon.astro';
import Kamon from '../components/Kamon.astro';
import { srcset } from '../lib/img';
import faq from '../data/faq.json';
import site from '../data/site.json';
import pricing from '../data/pricing.json';
import reviews from '../data/reviews.json';
import { getTours, yen, AREA_JP, priceLabel } from '../lib/tours';
import { usdAmount } from '../lib/fx';
const tours = await getTours();

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'TravelAgency', name: site.name, url: Astro.site?.toString(), description: site.description, sameAs: [site.instagram, site.tiktok] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];

const slides = [
  { src: '/images/hero/secret-torii.webp', mobile: '/images/hero/secret-torii-m.webp', alt: 'A Ninja guide holding a paper lantern in a tunnel of red torii gates', caption: 'A hidden shrine · Shinjuku' },
  { src: '/images/hero/gyoen-smiles.webp', mobile: '/images/hero/gyoen-smiles-m.webp', alt: 'Three smiling guests with their Ninja guide at the gate of Shinjuku Gyoen', caption: 'Shinjuku Gyoen' },
  { src: '/images/hero/goldengai-night.webp', mobile: '/images/hero/goldengai-night-m.webp', alt: 'Two guests and their Ninja guide smiling under the neon of Kabukicho at night', caption: 'Kabukicho · Shinjuku' },
];



const google = reviews.ratings.find((r) => r.source === 'Google');

// Picture-scroll data for every tour, so the quiz's mission scroll can show the tour it picked
const pad2 = (n: number) => String(n).padStart(2, '0');
const scrollTours = Object.fromEntries(
  tours
    .filter((t) => t.data.story.some((c) => c.image))
    .map((t) => {
      const d = t.data;
      const pl = priceLabel(t);
      const soon = d.comingSoon || !d.bookingUrl;
      const price = soon
        ? '<strong>Launching soon</strong> <span>Ask us about dates</span>'
        : `<strong>${pl.amount}</strong> <span>≈US$${usdAmount(pl.jpy[0])}${pl.jpy[1] !== pl.jpy[0] ? `–${usdAmount(pl.jpy[1])}` : ''} ${pl.note}</span>`;
      return [t.id, {
        price, soon,
        id: t.id,
        eyebrow: `Your mission: ${d.shortTitle}`,
        title: d.tagline ?? d.shortTitle,
        sub: `${d.shortTitle} · ${d.durationMinutes} min`,
        tate: `${AREA_JP[d.area]}の${d.themes.includes('Nightlife') ? '一夜' : '一刻'}`,
        cta: soon ? 'Ask about dates' : 'Book this mission',
        href: soon ? `/contact?tour=${t.id}` : d.bookingUrl!,
        scenes: d.story.filter((c) => c.image).map((c, n) => ({ kicker: `Scene ${pad2(n + 1)}`, title: c.title, text: c.text, image: c.image!, srcset: srcset(c.image!, 1400), alt: c.imageAlt ?? '' })),
      }];
    }),
);
const firstTour = tours.find((t) => t.id === 'shinjuku-secret-shrine') ?? tours[0];
const firstScroll = scrollTours[firstTour.id];
---
<Base jsonLd={jsonLd} image="/images/og.jpg" overlayHeader>
  <!-- First visit only: sliding doors open onto Tokyo -->
  <script is:inline>
    try {
      if (!sessionStorage.getItem('ngt-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('intro');
        new Image().src = '/images/brand/logo-light-320.webp';
        sessionStorage.setItem('ngt-intro', '1');
      }
    } catch (e) {}
  </script>
  <div class="curtain" aria-hidden="true">
    <div class="curtain__door curtain__door--l"></div>
    <div class="curtain__door curtain__door--r"></div>
    <span class="curtain__seal"></span>
  </div>

  <section class="hero">
    <HeroSlideshow slides={slides} />
    <div class="hero__shade" aria-hidden="true"></div>
    <Mist />
    <div class="wrap hero__in">
      <p class="hero__kicker">Walking tours · Tokyo</p>
      <Split as="h1" class="hero__title" text="Follow | the *Ninja.*" delay={900} />
      <p class="hero__lead">Secret shrines. Tiny bars. Neon alleys. <b>60 minutes.</b></p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="#missions" data-track="click_hero_cta">Choose your mission</a>
      </div>
      <p class="hero__by">
        <a href="#produced-by" data-track="click_hero_producer"><img src="/images/brand/nkt-mark-white.webp" width="240" height="230" alt="" /><span><small>Produced by</small>Ninja + Kabuki Tokyo</span></a>
        {google && <span class="hero__rate"><b>{google.score.toFixed(1)}</b><i aria-hidden="true">★★★★★</i><small>Google · {google.count} reviews</small></span>}
        <span class="hero__rate"><b>{reviews.producer.rating.score.toFixed(1)}</b><i aria-hidden="true">★★★★★</i><small>{reviews.producer.rating.source} · Ninja + Kabuki Tokyo</small></span>
      </p>
      <div class="hero__talk dlg" aria-hidden="true" data-dlg='[["YOU","Where do locals go?"],["NINJA","Follow me. A shrine hides behind the neon."]]'>
        <p class="dlg__who" data-dlg-who>YOU</p>
        <p class="dlg__txt" data-dlg-txt></p>
        <span class="dlg__next">▼</span>
      </div>
    </div>
    <a class="hero__scroll" href="#missions" aria-label="Scroll to tours"><span></span></a>
  </section>



  <section class="section missions" id="missions">
    <div class="wrap missions__head">
      <div>
        <p class="eyebrow">Choose your mission</p>
        <Split text="Pick your | adventure." />
      </div>
      <ul class="facts">
        <li><Icon name="clock" /> 60 min</li>
        <li><Icon name="yen" /> Book direct, best price</li>
        <li><Icon name="chat" /> English guide</li>
        <li><Icon name="kid" /> Kids welcome</li>
      </ul>
    </div>
    <MissionRail tours={tours} />
    <div class="wrap"><NextStep lead="Can’t pick one?" label="Let the scroll decide" href="#quiz" where="home_missions" /></div>
  </section>

  <TokyoMap tours={tours} />

  <NinjaQuiz tours={tours} />



  <!-- The quiz's mission scroll: hidden until the guest opens their sealed scroll; then the quiz turns into it in place (smoke bomb), it lands with a DON! and unrolls the route -->
  <div id="mission">
    <Emaki
      id="mission-scroll"
      scenes={firstScroll.scenes}
      cover={{ title: firstScroll.title, sub: firstScroll.sub, tate: firstScroll.tate }}
      kamon={firstTour?.data.kamon}
      tour={firstScroll.id}
      eyebrow="Your mission, unrolled"
      closed
      switchable
      mission
      end={{ title: 'Your turn.', cta: firstScroll.cta, href: firstScroll.href, external: true }}
    />
    <script type="application/json" data-emk-tours set:html={JSON.stringify(scrollTours)} />
    {tours.map((t) => <template data-emk-kamon-tpl={t.id}><Kamon name={t.data.kamon} size={54} class="emk__kamon" /></template>)}
  </div>

  <section class="stats" aria-label="NINJA GO TOURS in numbers">
    <div class="wrap stats__grid">
      <div data-reveal><strong><span data-count="280">0</span>+</strong><span>tiny bars, one Ninja</span></div>
      <div data-reveal style="--d:100ms"><strong><span data-count="60">0</span></strong><span>minutes of Tokyo magic</span></div>
      {google && <div data-reveal style="--d:200ms"><strong><span data-count={google.score.toFixed(1)}>0</span>★</strong><span>on Google ({google.count} reviews)</span></div>}
      <div data-reveal style="--d:300ms"><strong><span data-count="1">0</span></strong><span>local guide leads the way</span></div>
    </div>
  </section>

  <ProducedBy />

  <Reviews />

  <section class="section price" id="pricing">
    <div class="wrap">
      <p class="eyebrow">Group pricing</p>
      <Split text="Bring friends. | Pay less each." />
      <p class="lead">Priced by your booking: more friends, lower price each.</p>
      <!-- Edo gold coins (koban): gozame ridges, stamped numeral seal on top, 両 seal below -->
      <ul class="coins" data-reveal>
        {pricing.tiers.map((t, i) => (
          <li class:list={['koban', { 'koban--best': i === pricing.tiers.length - 1 }]} style={`--k:${i}`}>
            {i === pricing.tiers.length - 1 && <span class="koban__best">Best value</span>}
            <span class="koban__seal" aria-hidden="true">{['壹', '弐', '参', '肆'][i]}</span>
            <span class="koban__who">{t.label}</span>
            <strong>{yen(t.pricePerPerson)}</strong>
            <Usd jpy={t.pricePerPerson} class="koban__usd" />
            <span class="koban__per">per adult</span>
            <span class="koban__ryo" aria-hidden="true">両</span>
          </li>
        ))}
      </ul>
      <p class="price__note">Kids 12 and under join free with a paying adult. Some tours add a materials fee; the E-Scooter tour has its own price.</p>
      <NextStep lead="Four friends? ¥2,500 each." label="Pick your tour" href="#missions" where="home_pricing" />
    </div>
  </section>

  <section class="section section--paper2 how">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <Split text="Three steps. | Zero stress." />
      <ol class="how__steps">
        <li data-reveal><span class="how__i"><Icon name="shuriken" size={34} /></span><strong>Pick a mission</strong><p>Shrines, bars, food or kanji.</p></li>
        <li data-reveal style="--d:120ms"><span class="how__i"><Icon name="clock" size={34} /></span><strong>Book online</strong><p>Choose a date. Done.</p></li>
        <li data-reveal style="--d:240ms"><span class="how__i"><Icon name="mask" size={34} /></span><strong>Meet your Ninja</strong><p>Say “Konnichiwa!” and go.</p></li>
      </ol>
      <NextStep lead="Step one takes a minute." label="Pick a mission" href="#missions" where="home_how" />
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="wrap">
      <p class="eyebrow">FAQ</p>
      <h2>Questions? Answered.</h2>
      <div class="faq__list">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <NextStep lead="Something we didn’t answer?" label="Ask us" href="/contact" where="home_faq" />
    </div>
  </section>

  <section class="go">
    <img class="go__img" src="/images/hero/secret-torii.webp" srcset="/images/hero/secret-torii-640.webp 640w, /images/hero/secret-torii-1024.webp 1024w, /images/hero/secret-torii.webp 2000w" sizes="100vw" alt="" loading="lazy" width="2000" height="1125" />
    <Mist strength={0.8} />
    <img class="go__seal" data-stamp style="--r:-10deg" src="/images/brand/logo-light-160.webp" alt="" width="160" height="160" loading="lazy" />
    <div class="wrap go__in">
      <Split text="Your Ninja | is waiting." />
      <a class="btn btn--primary btn--lg" href="#missions" data-track="click_final_cta">Choose your mission</a>
    </div>
  </section>
</Base>


<script>
  // Dialogue window: types the lines one after another, like an RPG
  const dlg = document.querySelector<HTMLElement>('[data-dlg]');
  if (dlg && getComputedStyle(dlg).display !== 'none') {
    const lines: [string, string][] = JSON.parse(dlg.dataset.dlg || '[]');
    const who = dlg.querySelector('[data-dlg-who]')!;
    const txt = dlg.querySelector('[data-dlg-txt]')!;
    const last = lines[lines.length - 1];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { who.textContent = last[0]; txt.textContent = last[1]; }
    else {
      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
      (async () => {
        await wait(document.documentElement.classList.contains('intro') ? 2600 : 900);
        for (const [w, t] of lines) {
          who.textContent = w; txt.textContent = '';
          for (let i = 1; i <= t.length; i++) { txt.textContent = t.slice(0, i); await wait(38); }
          await wait(1400);
        }
      })();
    }
  }
</script>
<style>
  /* Sliding-door intro (first visit only) */
  .curtain { display: none; }
  :global(html.intro) .curtain { display: block; position: fixed; inset: 0; z-index: 100; pointer-events: none; }
  .curtain__door { position: absolute; top: 0; bottom: 0; width: 50.5%; background: var(--night) var(--seigaiha); animation: door 1s cubic-bezier(.7,0,.2,1) 0.55s forwards; }
  .curtain__door--l { left: 0; border-right: 1px solid rgb(247 240 227 / 0.55); }
  .curtain__door--r { right: 0; border-left: 1px solid rgb(247 240 227 / 0.55); --dir: 1; }
  .curtain__door--l { --dir: -1; }
  @keyframes door { to { transform: translateX(calc(var(--dir) * 101%)); } }
  .curtain__seal { position: absolute; left: 50%; top: 50%; width: 150px; height: 150px; margin: -75px 0 0 -75px; border-radius: 50%; background: var(--night) url(/images/brand/logo-light-320.webp) center / contain no-repeat; animation: seal 1.2s ease forwards; }
  @keyframes seal { 0% { transform: scale(2) rotate(-40deg); opacity: 0; } 28% { transform: scale(1) rotate(-8deg); opacity: 1; } 62% { transform: scale(1) rotate(-8deg); opacity: 1; } 100% { transform: scale(0.5) rotate(20deg); opacity: 0; } }

  /* Hero */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; color: #fff; overflow: hidden; }
  .hero__shade { position: absolute; inset: 0; background: radial-gradient(ellipse 75% 70% at 0% 100%, rgb(8 8 18 / 0.9) 0%, rgb(8 8 18 / 0.55) 45%, rgb(8 8 18 / 0) 80%), linear-gradient(0deg, rgb(8 8 18 / 0.6), rgb(8 8 18 / 0) 40%), linear-gradient(180deg, rgb(8 8 18 / 0.45), rgb(8 8 18 / 0) 25%); }
  @keyframes fade-in { from { opacity: 0; transform: translateY(-20px); } }
  .hero__in { position: relative; z-index: 2; width: 100%; padding-top: 120px; padding-bottom: 72px; }
  .hero__kicker { font-family: var(--mono); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lantern); margin-bottom: 0.8em; animation: fade-in 1s ease 0.7s both; }
  .hero :global(.hero__title) { font-size: clamp(3.6rem, 12vw, 10rem); line-height: 0.92; letter-spacing: -0.01em; margin-bottom: 0.3em; text-shadow: 0 4px 40px rgb(0 0 0 / 0.35); }
  .hero :global(.hero__title em) { font-style: normal; color: transparent; -webkit-text-stroke: 2px var(--cream); }
  .hero__lead { font-size: clamp(1.1rem, 1.8vw, 1.4rem); max-width: 30em; color: rgb(255 255 255 / 0.92); animation: fade-in 1s ease 1.5s both; }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 22px; animation: fade-in 1s ease 1.7s both; }
  .btn--lg { padding: 1.05em 1.9em; font-size: 1.1rem; }
  /* who is behind it, and what guests say: right under the call to action */
  .hero__by { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; margin: 22px 0 0; animation: fade-in 1s ease 1.9s both; }
  .hero__by a { display: inline-flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; padding-right: 22px; border-right: 1px solid rgb(255 255 255 / 0.35); }
  .hero__by img { width: 44px; height: auto; }
  .hero__by a span { display: flex; flex-direction: column; font-family: var(--display); font-size: 1.15rem; text-transform: uppercase; line-height: 1.05; }
  .hero__by small { font-family: var(--mono); font-weight: 700; font-size: 0.66rem; letter-spacing: 0.12em; color: rgb(255 255 255 / 0.75); text-transform: uppercase; }
  .hero__by a:hover span { text-decoration: underline; }
  .hero__rate { display: inline-grid; grid-template-columns: auto auto; column-gap: 8px; align-items: center; }
  .hero__rate b { grid-row: span 2; font-family: var(--display); font-weight: 400; font-size: 2rem; line-height: 1; }
  .hero__rate i { font-style: normal; color: #e7c465; font-size: 0.8rem; letter-spacing: 0.1em; }
  .hero__rate small { font-size: 0.62rem; }
  .hero__talk { position: absolute; right: 16px; bottom: 110px; width: min(340px, 30vw); }
  /* RPG-style dialogue window */
  .dlg { background: rgb(13 15 28 / 0.84); color: var(--cream); border: 2px solid var(--cream); box-shadow: inset 0 0 0 4px var(--night), inset 0 0 0 5px rgb(247 240 227 / 0.45), 0 12px 30px rgb(0 0 0 / 0.4); padding: 18px 18px 22px; min-height: 104px; animation: pop 0.5s 2s both; }
  .dlg__who { position: absolute; top: -13px; left: 14px; margin: 0; padding: 2px 9px; background: var(--cream); color: var(--night); font-family: var(--mono); font-weight: 700; font-size: 0.72rem; letter-spacing: 0.1em; }
  .dlg__txt { margin: 0; font-family: var(--mono); font-size: 0.92rem; line-height: 1.5; min-height: 3em; }
  .dlg__next { position: absolute; right: 12px; bottom: 6px; font-size: 0.7rem; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes pop { from { opacity: 0; transform: translateY(12px) scale(0.95); } to { opacity: 1; transform: none; } }
  .hero__scroll { position: absolute; left: 50%; bottom: 18px; width: 26px; height: 42px; margin-left: -13px; border: 2px solid rgb(255 255 255 / 0.7); border-radius: 14px; }
  .hero__scroll span { position: absolute; left: 50%; top: 8px; width: 4px; height: 8px; margin-left: -2px; border-radius: 2px; background: #fff; animation: scroll-dot 1.8s ease-in-out infinite; }
  @keyframes scroll-dot { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }


  /* Missions */
  .missions { overflow: hidden; }
  .missions__head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px 48px; align-items: end; margin-bottom: 24px; }
  .missions__head :global(h2), .price :global(h2), .how :global(h2) { font-size: clamp(2.4rem, 6vw, 4.6rem); line-height: 1; }

  .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }
  .facts li { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1.5px solid var(--ai); border-radius: 4px; font-family: var(--mono); font-weight: 700; font-size: 0.82rem; text-transform: uppercase; }
  .facts :global(.icon) { color: var(--shu); }

  /* Stats */
  .stats { background: var(--night); color: var(--cream); padding: 48px 0; border-top: 1px solid var(--night-3); }
  .stats__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .stats__grid div { display: flex; flex-direction: column; gap: 6px; border-left: 2px solid rgb(247 240 227 / 0.5); padding-left: 16px; }
  .stats__grid strong { font-family: var(--display); font-weight: 400; font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1; color: var(--lantern); }
  .stats__grid span { color: #cfc6b6; font-family: var(--mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; }


  /* Price coins: Edo koban (oval gold coins) */
  .coins { list-style: none; padding: 0; margin: 40px auto 24px; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(14px, 3vw, 40px); max-width: 980px; perspective: 900px; }
  .koban { --ink: #3b2708; position: relative; aspect-ratio: 5 / 7.4; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; text-align: center; color: var(--ink); overflow: hidden;
    background:
      radial-gradient(ellipse 60% 40% at 32% 18%, rgb(255 250 220 / 0.75), transparent 70%),
      repeating-linear-gradient(0deg, rgb(110 70 5 / 0.16) 0 1.5px, transparent 1.5px 6px),
      linear-gradient(160deg, #f8e59a 0%, #dcae45 38%, #f2d472 58%, #b98424 100%);
    box-shadow: inset 0 0 0 3px rgb(255 244 196 / 0.55), inset 0 0 0 9px rgb(140 92 18 / 0.28), inset 0 -14px 26px rgb(110 70 5 / 0.3), 0 16px 30px -8px rgb(70 45 0 / 0.45); }
  /* sheen that sweeps across on hover */
  .koban::after { content: ''; position: absolute; inset: -20%; background: linear-gradient(105deg, transparent 40%, rgb(255 255 240 / 0.7) 50%, transparent 60%); transform: translateX(-80%); transition: transform 0.9s cubic-bezier(.2,.7,.2,1); pointer-events: none; }
  .koban:hover::after { transform: translateX(80%); }
  .koban__seal, .koban__ryo { font-family: var(--mincho); font-weight: 800; display: grid; place-items: center; border: 2px solid currentColor; border-radius: 50%; line-height: 1; opacity: 0.85; }
  .koban__seal { width: clamp(34px, 4vw, 46px); height: clamp(34px, 4vw, 46px); font-size: clamp(1.05rem, 1.6vw, 1.45rem); margin-bottom: 8px; box-shadow: inset 0 0 0 3px rgb(255 240 190 / 0.35); }
  .koban__ryo { width: 26px; height: 26px; font-size: 0.85rem; margin-top: 8px; border-radius: 6px; }
  .koban strong { font-family: var(--display); font-weight: 400; font-size: clamp(1.6rem, 3.1vw, 2.7rem); line-height: 1; text-shadow: 0 1px 0 rgb(255 245 205 / 0.6); }
  .koban__who { font-family: var(--mono); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.78rem; }
  .koban__per { font-size: 0.8rem; font-weight: 600; opacity: 0.85; }
  .koban :global(.koban__usd) { font-family: var(--mono); font-weight: 700; font-size: 0.78rem; }
  .koban--best { transform: scale(1.06); }
  .koban--best::after { animation: koban-shine 3.6s ease-in-out 1.6s infinite; }
  @keyframes koban-shine { 0%, 60% { transform: translateX(-80%); } 85%, 100% { transform: translateX(80%); } }
  .koban__best { position: absolute; top: 9%; font-family: var(--mono); font-weight: 700; font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; background: var(--ai); color: var(--cream); padding: 3px 8px; border-radius: 999px; }
  .koban--best .koban__seal { margin-top: 18px; }
  /* coins flip in, one after another, when the section scrolls into view (.js is on <html>, hence :global) */
  :global(.js) .coins[data-reveal] { opacity: 1; transform: none; }
  .coins .koban { transition: transform 0.8s cubic-bezier(.3,1.4,.5,1), opacity 0.4s; transition-delay: calc(var(--k) * 0.15s); }
  :global(.js) .coins:not(.is-in) .koban { opacity: 0; transform: translateY(-40px) rotateY(100deg); }
