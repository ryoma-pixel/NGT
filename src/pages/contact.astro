---
import Base from '../layouts/Base.astro';
---
<Base title="Contact Us" description="Questions about a tour, group bookings or private requests? Send NINJA GO TOURS a message.">
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow"><span class="jp">お問い合わせ</span> Contact</p>
      <h1>Ask us anything</h1>
      <p class="lead">Questions about a tour, a larger group or a special request? Send us a message and we will reply by email.</p>
      <!-- Netlify Forms: submissions appear in the Netlify dashboard and can be forwarded by email -->
      <form class="card cf" name="contact" method="POST" action="/contact-thanks" data-netlify="true" netlify-honeypot="company">
        <input type="hidden" name="form-name" value="contact" />
        <p class="visually-hidden"><label>Leave this empty <input name="company" /></label></p>
        <label>Your name<input name="name" autocomplete="name" required /></label>
        <label>Email address<input type="email" name="email" autocomplete="email" required /></label>
        <label>Message<textarea name="message" rows="6" required></textarea></label>
        <button class="btn btn--primary" type="submit" data-track="submit_contact">Send message</button>
      </form>
    </div>
  </section>
</Base>
<style>
  .narrow { max-width: 680px; }
  .cf { padding: 24px; display: grid; gap: 16px; margin-top: 24px; }
  .cf label { display: grid; gap: 6px; font-weight: 700; font-size: 0.95rem; }
  .cf input, .cf textarea { font: inherit; padding: 0.7em 0.9em; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); }
  .cf input:focus, .cf textarea:focus { outline: 2px solid var(--lantern); border-color: transparent; }
  .cf button { justify-self: start; }
</style>
