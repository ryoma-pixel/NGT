---
import NextStep from '../../components/NextStep.astro';
import Emaki from '../../components/Emaki.astro';
import Tate from '../../components/Tate.astro';
import Base from '../../layouts/Base.astro';
import BookingBox from '../../components/BookingBox.astro';
import Split from '../../components/Split.astro';
import Icon from '../../components/Icon.astro';
import Kamon from '../../components/Kamon.astro';
import Mist from '../../components/Mist.astro';
import ReelRail from '../../components/ReelRail.astro';
import { getReels } from '../../lib/reels';
import TourCard from '../../components/TourCard.astro';
import { srcset } from '../../lib/img';
import { getTours, fromPrice, priceTiers, yen, AREA_JP } from '../../lib/tours';
import pricing from '../../data/pricing.json';
import reviews from '../../data/reviews.json';

export async function getStaticPaths() {
  const tours = await getTours();
  return tours.map((tour) => ({ params: { slug: tour.id }, props: { tour, tours } }));
}
const { tour, tours } = Astro.props;
const d = tour.data;
const related = tours.filter((t) => t.id !== tour.id && t.data.area === d.area).slice(0, 3);
const price = d.fixedPricePerPerson ?? fromPrice(tour);
const priceNote = d.fixedPricePerPerson ? 'per person' : 'per person, groups of 4+';

// Timeline: minutes come from the itinerary titles, e.g. "Golden Gai (25 min)", shown as 00–25 style ranges
const steps = d.itinerary.map((s) => {
  const m = s.title.match(/\((?:about |approx\.\s*)?(\d+)\s*min/i);
  return { label: s.title.replace(/\s*\((?:about |approx\.\s*)?\d+\s*min[^)]*\)/i, ''), minutes: m ? Number(m[1]) : 0 };
});
let clock = 0;
const timeline = steps.map((s) => {
  const from = clock;
  clock += s.minutes;
  return { ...s, from, to: clock };
});
const pad = (n: number) => String(n).padStart(2, '0');
const showRanges = clock > 0 && clock <= d.durationMinutes + 30;

// Questions about this tour, answered from the tour data, then the tour's own questions.
// General questions (private tours, kids, language, why book direct) live in the top page FAQ.
const tiers = priceTiers(tour);
const priceAnswer = d.fixedPricePerPerson
  ? `${yen(d.fixedPricePerPerson)} per person.`
  : `${tiers.map((t) => `${t.label}: ${yen(t.pricePerPerson)} each`).join(' · ')}. ${pricing.childPolicy}`;
const faq = [
  ...(d.meetingPoint ? [{ q: 'Where do we meet?', a: [d.meetingPoint.name, d.meetingPoint.access, d.meetingPoint.lookFor].filter(Boolean).join(' '), map: d.meetingPoint.mapUrl }] : []),
  ...(d.startTimes ? [{ q: 'When does it start?', a: `${d.startTimes}. The tour takes about ${d.durationMinutes} minutes.` }] : []),
  { q: 'How much does it cost?', a: priceAnswer },
  { q: 'How do I book?', a: `Tap “Check availability”, then pick a date and time and complete your booking online. A confirmation email follows.${d.bookingDeadline ? ` ${d.bookingDeadline}.` : ''}` },
  ...d.faq,
];

const tourReviews = reviews.items.filter((r) => r.tours.includes(tour.id));
const heroThumbs = d.gallery.slice(0, 3);
// Gallery mosaic: first photo is big (2x2); make just enough photos tall (1x2) so the 4-column grid has no holes
const extraTall = (4 - ((3 + d.gallery.length) % 4)) % 4;
const tallIdx = new Set(Array.from({ length: extraTall }, (_, k) => 3 + k * 2).filter((i) => i < d.gallery.length));
const galClass = (i: number) => (i === 0 ? 'gal__item gal__item--big' : tallIdx.has(i) ? 'gal__item gal__item--tall' : 'gal__item');
const finale = d.story.at(-1)?.image ?? d.heroImage;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: d.title,
    description: d.summary,
    ...(d.heroImage ? { image: new URL(d.heroImage, Astro.site).toString() } : {}),
    offers: { '@type': 'Offer', price, priceCurrency: 'JPY', availability: 'https://schema.org/InStock', url: new URL(`/tour/${tour.id}`, Astro.site).toString() },
    provider: { '@type': 'Organization', name: 'NINJA GO TOURS', url: Astro.site?.toString() },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const reels = getReels(await getTours(), tour.id);
---
<Base title={d.title} description={d.summary} image={d.heroImage} jsonLd={jsonLd} overlayHeader>
  <!-- 1. Hero: one big promise -->
  <section class="th">
    {d.heroImage && <img class="th__img" src={d.heroImage} srcset={srcset(d.heroImage, 1600)} sizes="100vw" alt={d.heroAlt ?? ''} width="1600" height="1000" fetchpriority="high" />}
    <span class="tate tate--area" aria-hidden="true">{AREA_JP[d.area]}</span>
    <div class="wrap th__in">
      {d.draft && <span class="badge badge--draft">DRAFT – not shown on the live site</span>}
      <div class="th__label"><Kamon name={d.kamon} size={52} /><h1 class="th__title">{d.title}</h1></div>
      <Split as="p" class="th__tag" text={d.tagline ?? d.shortTitle} delay={150} />
      <ul class="th__meta">
        <li><Icon name="clock" size={18} /> {d.durationMinutes} min</li>
        {d.privateTour && <li><Icon name="group" size={18} /> Just your group</li>}
        <li><Icon name="chat" size={18} /> {d.language}</li>
        {d.ageNote && <li><Icon name="kid" size={18} /> {d.ageNote}</li>}
      </ul>
      <div class="th__cta">
        <a class="btn btn--primary btn--lg" href="#book" data-track="click_hero_book" data-tour={tour.id}>Check availability</a>
        <p class="th__price"><strong>{yen(price)}</strong> {priceNote}</p>
      </div>
      {heroThumbs.length > 0 && (
        <div class="th__thumbs">
          {heroThumbs.map((g, i) => (
            <button type="button" class="th__thumb" data-open-gallery={i} aria-label={`Open photo: ${g.alt}`}>
              <img src={g.src} srcset={srcset(g.src, 1400)} sizes="160px" alt="" width="160" height="110" loading="lazy" />
            </button>
          ))}
          <button type="button" class="th__more" data-open-gallery="0">+{d.gallery.length}</button>
        </div>
      )}
    </div>
  </section>


  <!-- 2. What you will do, at a glance -->
  {d.features.length > 0 && (
    <section class="feat">
      <div class="wrap">
        <p class="eyebrow">What you’ll do</p>
        <ul class="feat__list">
          {d.features.map((f, i) => (
            <li data-reveal style={`--d:${i * 90}ms`}>
              <span class="feat__icon"><Icon name={f.icon} size={40} /></span>
              <strong>{f.label}</strong>
            </li>
          ))}
        </ul>
        <NextStep dark lead="Sounds like your kind of night?" label="Check dates" href="#book" where="tour_features" tour={tour.id} />
      </div>
    </section>
  )}

  <!-- 3. The 60 minutes, as a story -->
  {d.story.length > 0 && (
    <section class="section story">
      <div class="wrap">
        <Split text={`Your ${d.durationMinutes} minutes`} />
        {timeline.length > 1 && (
          <ol class="tl" aria-label="Tour timeline" data-reveal>
            {timeline.map((s, k) => (
              <li style={`flex:${Math.max(s.minutes, 4)}; --k:${k}`}>
                <span class="tl__seg"></span>
                <span class="tl__time">{showRanges && s.minutes ? `${pad(s.from)}–${pad(s.to)} min` : s.minutes ? `${s.minutes} min` : k === 0 ? 'Start' : 'End'}</span>
                <span class="tl__label">{s.label}</span>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  )}

  {d.story.length > 0 && (
    <Emaki
      id="scroll"
      eyebrow={`Your ${d.durationMinutes} minutes, unrolled`}
      tour={tour.id}
      kamon={d.kamon}
      cover={{ title: d.tagline ?? d.shortTitle, sub: `${d.shortTitle} · ${d.durationMinutes} min`, tate: `${AREA_JP[d.area]}の${d.themes.includes('Nightlife') ? '一夜' : '一刻'}` }}
      scenes={d.story.filter((c) => c.image).map((c, n) => ({ kicker: `Side quest ${pad(n + 1)}`, title: c.title, text: c.text, image: c.image!, alt: c.imageAlt ?? '' }))}
      end={{ title: 'Your turn.', cta: 'See available times', href: d.bookingUrl ?? '#book', external: !!d.bookingUrl }}
    />
  )}

  <!-- 4. Photos -->
  {d.gallery.length > 0 && (
    <section class="section section--dark gal">
      <div class="wrap">
        <p class="eyebrow">From our tours</p>
        <Split text="See it before you go" />
        <div class="gal__grid">
          {d.gallery.map((g, i) => (
            <button type="button" class={galClass(i)} data-open-gallery={i} aria-label={`Open photo: ${g.alt}`}>
              <img src={g.src} srcset={srcset(g.src, 1100)} sizes="(max-width: 900px) 50vw, 25vw" alt={g.alt} width="1100" height="733" loading="lazy" />
            </button>
          ))}
        </div>
      </div>
      <dialog class="lb" aria-label="Photo viewer">
        <button type="button" class="lb__close" aria-label="Close">×</button>
        <button type="button" class="lb__nav lb__prev" aria-label="Previous photo">‹</button>
        <figure><img alt="" /><figcaption></figcaption></figure>
        <button type="button" class="lb__nav lb__next" aria-label="Next photo">›</button>
      </dialog>
      <script type="application/json" id="gallery-data" set:html={JSON.stringify(d.gallery)} />
    </section>
  )}

  {reels.length > 0 && (
    <section class="section reels">
      <div class="wrap">
        <p class="eyebrow">Straight from Instagram</p>
        <h2>See it for real</h2>
        <ReelRail reels={reels} />
        <NextStep lead="Your turn to film it." label="Check availability" href={d.bookingUrl ?? '#book'} where="tour_reels" tour={tour.id} external />
      </div>
    </section>
  )}

  <!-- 5. Guests -->
  {tourReviews.length > 0 && (
    <section class="section tr">
      <div class="wrap">
        <p class="eyebrow">From our guests</p>
        <div class="tr__list">
          {tourReviews.map((r) => (
            <figure class="tr__item" data-reveal>
              <span class="tr__stars" aria-label={`${r.stars} out of 5 stars`}>{'★'.repeat(r.stars)}</span>
              <blockquote>“{r.text}”</blockquote>
              <figcaption>{r.author} — {r.source} review</figcaption>
            </figure>
          ))}
        </div>
        <NextStep lead="Join them." label="Book your date" href={d.bookingUrl ?? '#book'} where="tour_reviews" tour={tour.id} external />
      </div>
    </section>
  )}

  <!-- 6. Questions answered + booking -->
  <section class="section section--paper2 plan" id="plan">
    <div class="wrap plan__grid">
      <div class="plan__main">
        <p class="eyebrow">Good to know</p>
        <Split text="Questions? Answered." />
        {d.meetingPoint?.image && (
          <figure class="mp">
            <img src={d.meetingPoint.image} alt={d.meetingPoint.imageAlt ?? ''} width="1000" height="667" loading="lazy" />
            <figcaption><Icon name="pin" size={18} /> Meeting point: {d.meetingPoint.name}</figcaption>
          </figure>
        )}
        <div class="faq">
          {faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
              {'map' in f && f.map && <a class="faq__map" href={f.map} rel="noopener" target="_blank" data-track="click_map" data-tour={tour.id}><Icon name="pin" size={16} /> Open in Google Maps</a>}
            </details>
          ))}
        </div>
        <p class="faq__more">Private tours, kids, language and more: <a href="/#faq" data-track="click_next_step" data-location="tour_faq_general">general FAQ</a>.</p>
      </div>
      <div class="plan__side">
        <BookingBox tour={tour} />
      </div>
    </div>
  </section>

  <div class="sbar" data-sbar aria-hidden="true">
    <div class="wrap sbar__in">
      <p class="sbar__t">{d.shortTitle}</p>
      <p class="sbar__p"><strong>{yen(price)}</strong> {priceNote}</p>
      <a class="btn btn--primary" href="#book" tabindex="-1" data-track="click_sticky_book" data-tour={tour.id}>Check availability</a>
    </div>
  </div>

  <!-- 7. Last push -->
  <section class="fin">
    {finale && <img class="fin__img" src={finale} srcset={srcset(finale, 1400)} sizes="100vw" alt="" width="1400" height="1050" loading="lazy" />}
    <Mist strength={0.8} />
    <div class="wrap fin__in">
      <Tate text="いざ出陣" class="tate--inline" />
      <img class="fin__seal" data-stamp style="--r:-10deg" src="/images/brand/logo-light-160.webp" alt="" width="110" height="110" loading="lazy" />
      <Split text="Your Ninja is ready." />
      <a class="btn btn--primary btn--lg" href="#book" data-track="click_final_book" data-tour={tour.id}>Check availability</a>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section">
      <div class="wrap">
        <p class="eyebrow">More missions</p>
        <h2 class="more__h">More in {d.area}</h2>
        <div class="grid grid--3">{related.map((t) => <TourCard tour={t} />)}</div>
      </div>
    </section>
  )}
</Base>

<script>
  // Desktop booking bar: slides up once the hero is out of view, hides again near the booking box
  const sbar = document.querySelector<HTMLElement>('[data-sbar]');
  const hero = document.querySelector('.th');
  const plan = document.getElementById('plan');
  if (sbar && hero && plan) {
    let heroOut = false, planIn = false;
    const sync = () => sbar.classList.toggle('is-on', heroOut && !planIn);
    new IntersectionObserver(([e]) => { heroOut = !e.isIntersecting; sync(); }).observe(hero);
    new IntersectionObserver(([e]) => { planIn = e.isIntersecting; sync(); }, { rootMargin: '0px 0px -30% 0px' }).observe(plan);
  }
</script>

<script>
  // Photo viewer for the gallery and hero thumbnails
  const dataEl = document.getElementById('gallery-data');
  const dlg = document.querySelector<HTMLDialogElement>('.lb');
  if (dataEl && dlg) {
    const photos: { src: string; alt: string }[] = JSON.parse(dataEl.textContent || '[]');
    const img = dlg.querySelector('img')!;
    const cap = dlg.querySelector('figcaption')!;
    let idx = 0;
    const show = (i: number) => {
      idx = (i + photos.length) % photos.length;
      img.src = photos[idx].src;
      img.alt = photos[idx].alt;
      cap.textContent = `${idx + 1} / ${photos.length} · ${photos[idx].alt}`;
    };
    document.querySelectorAll<HTMLElement>('[data-open-gallery]').forEach((b) =>
      b.addEventListener('click', () => { show(Number(b.dataset.openGallery)); dlg.showModal(); }),
    );
    dlg.querySelector('.lb__close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb__prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.lb__next')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(idx + 1);
      if (e.key === 'ArrowLeft') show(idx - 1);
    });
  }
</script>

<style>
  /* Hero */
  .th { position: relative; min-height: 100svh; display: flex; align-items: flex-end; background: var(--night); color: #fff; overflow: hidden; }
  .th__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: th-zoom 20s ease-out both; }
  .th::before { content: ''; position: absolute; inset: 0; z-index: 1; background: radial-gradient(ellipse 80% 70% at 0% 100%, rgb(8 8 18 / 0.92) 0%, rgb(8 8 18 / 0.55) 50%, rgb(8 8 18 / 0) 85%), linear-gradient(0deg, rgb(8 8 18 / 0.6), rgb(8 8 18 / 0) 40%), linear-gradient(180deg, rgb(8 8 18 / 0.5), rgb(8 8 18 / 0) 22%); }
  .th__in { position: relative; z-index: 2; width: 100%; padding: 120px 16px 48px; }
  .th__label { display: flex; align-items: center; gap: 14px; margin: 0 0 0.9em; }
  .th__title { font-family: var(--mono); font-weight: 700; font-size: clamp(0.78rem, 1.2vw, 0.92rem); letter-spacing: 0.1em; text-transform: uppercase; color: var(--lantern); margin: 0; max-width: 40em; }
  .th :global(.th__tag) { font-family: var(--display); font-size: clamp(2.6rem, 7.4vw, 6.6rem); line-height: 1; margin: 0 0 0.35em; max-width: 11em; text-shadow: 0 4px 40px rgb(0 0 0 / 0.4); }
  .th__meta { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; font-weight: 700; font-size: 0.9rem; animation: rise 0.9s ease 0.7s both; }
  .th__meta li { display: inline-flex; align-items: center; gap: 6px; background: rgb(255 255 255 / 0.14); border: 1px solid rgb(255 255 255 / 0.25); backdrop-filter: blur(6px); border-radius: 999px; padding: 0.4em 0.95em; }
  .th__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 22px; animation: rise 0.9s ease 0.9s both; }
  .btn--lg { padding: 1.05em 1.9em; font-size: 1.1rem; }
  .th__price { margin: 0; color: rgb(255 255 255 / 0.85); }
  .th__price strong { font-family: var(--display); font-weight: 400; font-size: 1.7rem; color: #fff; }
  .th__thumbs { position: absolute; right: 16px; bottom: 48px; display: flex; gap: 8px; align-items: stretch; animation: rise 0.9s ease 1.1s both; }
  .th__thumb, .th__more { border: 2px solid rgb(255 255 255 / 0.8); border-radius: 12px; overflow: hidden; padding: 0; cursor: pointer; background: rgb(0 0 0 / 0.4); }
  .th__thumb img { width: 104px; height: 72px; object-fit: cover; display: block; transition: transform 0.4s; }
  .th__thumb:hover img { transform: scale(1.08); }
  .th__more { color: #fff; font-family: var(--display); padding: 0 14px; font-size: 1rem; }
  @keyframes th-zoom { from { transform: scale(1.12); } to { transform: scale(1); } }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
  @supports (animation-timeline: scroll()) {
    .th__img { animation: th-zoom 20s ease-out both, th-drift linear both; animation-timeline: auto, scroll(root); animation-range: normal, 0 100vh; }
    @keyframes th-drift { to { translate: 0 20%; } }
  }

  /* What you'll do */
  .feat { background: var(--night); color: var(--cream); padding: 44px 0 56px; }
  .feat .eyebrow { color: var(--lantern); }
  .tate--area { position: absolute; z-index: 1; right: 4vw; top: 16vh; left: auto; font-size: clamp(2.4rem, 5vw, 4.4rem); color: var(--cream); text-shadow: 0 4px 30px rgb(0 0 0 / 0.5); animation: rise 1.4s cubic-bezier(.2,.8,.2,1) 0.3s both; }
  .fin :global(.tate--inline) { position: static; display: inline-block; color: var(--cream); margin: 0 auto 18px; font-size: 1.5rem; }
  @media (max-width: 700px) { .tate--area { font-size: 2.2rem; top: 84px; right: 14px; } }
  .feat__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .feat__list li { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 22px; border-radius: var(--radius); background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.1); transition: transform 0.3s, background 0.3s; }
  .feat__list li:hover { transform: translateY(-4px); background: rgb(255 255 255 / 0.09); }
  .feat__icon { display: grid; place-items: center; width: 68px; height: 68px; border-radius: 50%; background: var(--cream); color: var(--night); }
  .feat__list strong { font-family: var(--display); font-weight: 400; font-size: 1.15rem; line-height: 1.25; }

  /* Timeline */
  .story :global(h2) { font-size: clamp(2.2rem, 5vw, 4rem); }
  .tl { list-style: none; padding: 0; margin: 18px 0 56px; display: flex; gap: 6px; }
  .tl li { min-width: 96px; display: flex; flex-direction: column; gap: 6px; }
  .tl__seg { height: 12px; border-radius: 999px; background: var(--shu); transform-origin: left; }
  .tl li:nth-child(2n) .tl__seg { background: rgb(31 45 82 / 0.4); }
  .tl__time { font-family: var(--mono); font-weight: 700; font-size: 0.85rem; color: var(--ink); white-space: nowrap; }
  .tl__label { font-size: 0.85rem; font-weight: 600; line-height: 1.3; color: var(--muted); }
  .js .tl[data-reveal] { opacity: 1; transform: none; }
  .js .tl .tl__seg { transform: scaleX(0); transition: transform 0.7s cubic-bezier(.2,.8,.2,1); transition-delay: calc(var(--k) * 180ms); }
  .js .tl.is-in .tl__seg { transform: none; }

  /* Chapters */
  .chapters { display: grid; gap: 72px; }
  .ch { display: grid; grid-template-columns: 1.25fr 1fr; gap: 56px; align-items: center; }
  .ch:nth-child(even) .ch__media { order: 2; }
  .ch__media { margin: 0; border-radius: 26px; overflow: hidden; box-shadow: var(--shadow); aspect-ratio: 4 / 3; }
  .ch__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .ch:hover .ch__media img { transform: scale(1.05); }
  .ch__num { margin: 0; font-family: var(--display); font-size: clamp(4rem, 9vw, 7.5rem); line-height: 0.9; color: var(--shu); }
  .ch__text h3 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin: 0.2em 0 0.35em; }
  .ch__text p { color: var(--ink-2); font-size: 1.12rem; line-height: 1.6; margin: 0; max-width: 26em; }
  .ch__text .ch__quest { display: inline-block; margin: 0 0 6px; font-family: var(--mono); font-weight: 700; font-size: 0.72rem; line-height: 1.4; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cream); background: var(--ai); padding: 3px 8px; }

  /* Gallery */
  .gal :global(h2) { font-size: clamp(2rem, 4.4vw, 3.4rem); }
  .gal__grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 180px; grid-auto-flow: dense; gap: 10px; }
  .gal__item { position: relative; padding: 0; border: 0; border-radius: 14px; overflow: hidden; cursor: zoom-in; background: var(--night-3); }
  .gal__item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
  .gal__item:hover img { transform: scale(1.06); }
  .gal__item--big { grid-column: span 2; grid-row: span 2; }
  .gal__item--tall { grid-row: span 2; }
  .lb { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lb::backdrop { background: rgb(8 8 18 / 0.92); }
  .lb figure { margin: 0; height: 100%; display: grid; place-items: center; align-content: center; gap: 12px; padding: 60px 70px; }
  .lb img { max-width: 100%; max-height: 80vh; border-radius: 12px; }
  .lb figcaption { color: #ddd; font-size: 0.9rem; text-align: center; }
