---
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: object;
  /** Header floats transparently over a full-screen hero until the page scrolls */
  overlayHeader?: boolean;
  /** Utility pages (404, thank-you) are never indexed */
  noindex?: boolean;
}
const { title, description = site.description, image, jsonLd, overlayHeader = false, noindex = false } = Astro.props;
// Long titles (old column headlines) skip the brand suffix so search results cut them less
const fullTitle = title ? (title.length > 50 ? title : `${title} | ${site.name}`) : `${site.name} | ${site.tagline}`;
// build.format 'file' makes the build-time path end in .html; the live URL has no extension (/tour/slug)
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1') || '/', Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
// Search engines may index the site only on the real domain in production (not on *.netlify.app previews)
const indexable = process.env.CONTEXT === 'production' && /(^|\/\/)(www\.)?ninjagotours\.com/.test(process.env.URL ?? '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {(!indexable || noindex) && <meta name="robots" content={noindex && indexable ? 'noindex' : 'noindex, nofollow'} />}
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {site.gtmId ? (
      <script is:inline define:vars={{ id: site.gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
      </script>
    ) : site.ga4MeasurementId ? (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4MeasurementId}`}></script>
        <script is:inline define:vars={{ id: site.ga4MeasurementId }}>
          window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',id);
        </script>
      </>
    ) : null}
  </head>
  <body>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll motion: reveal / wipe / stamp elements as they enter, count numbers up, and solidify the header.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const countUp = (el: HTMLElement) => {
        const end = Number(el.dataset.count);
        const dec = (el.dataset.count || '').split('.')[1]?.length ?? 0;
        if (reduce) { el.textContent = end.toFixed(dec); return; }
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / 1400);
          el.textContent = (end * (1 - Math.pow(1 - p, 3))).toFixed(dec);
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.classList.add('is-in');
          if (el.dataset.count) countUp(el);
          io.unobserve(el);
        });
      }, { rootMargin: '0px 0px -12% 0px' });
      document.querySelectorAll('[data-reveal],[data-wipe],[data-stamp],[data-count]').forEach((el) => io.observe(el));

      const hdr = document.querySelector('.hdr');
      if (hdr) {
        const onScroll = () => hdr.classList.toggle('is-scrolled', scrollY > 40);
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    </script>
    <script>
      // Live exchange rate: refresh every "≈US$" amount ([data-jpy]) with today's rate, cached for 12 hours.
      import { FX_URLS } from '../lib/fx-sources';
      const KEY = 'ngt-fx';
      const apply = (rate: number) => {
        document.querySelectorAll<HTMLElement>('[data-jpy]').forEach((el) => {
          const [lo, hi] = el.dataset.jpy!.split('-').map(Number);
          const a = Math.round(lo * rate);
          el.textContent = hi ? `≈US$${a}–${Math.round(hi * rate)}` : `≈US$${a}`;
        });
      };
      (async () => {
        if (!document.querySelector('[data-jpy]')) return;
        try {
          const c = JSON.parse(localStorage.getItem(KEY) || 'null');
          if (c && Date.now() - c.t < 12 * 3600e3) return apply(c.r);
        } catch {}
        for (const url of FX_URLS) {
          try {
            const j = await (await fetch(url)).json();
            const r = j?.rates?.USD;
            if (r > 0.001 && r < 0.1) {
              apply(r);
              try { localStorage.setItem(KEY, JSON.stringify({ r, t: Date.now() })); } catch {}
              return;
            }
          } catch {}
        }
      })();
    </script>
    <script>
      // Analytics: any element with data-track sends an event (GA4 via gtag, or GTM via dataLayer).
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (!el) return;
        const params: Record<string, string | undefined> = { ...el.dataset };
        const event = params.track;
        delete params.track;
        const w = window as unknown as { gtag?: (...a: unknown[]) => void; dataLayer?: unknown[] };
        if (typeof w.gtag === 'function') w.gtag('event', event, params);
        else (w.dataLayer = w.dataLayer || []).push({ event, ...params });
      });
    </script>
  </body>
</html>
