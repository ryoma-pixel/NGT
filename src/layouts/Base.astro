---
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import reviews from '../data/reviews.json';
import { THEME_LABELS } from '../lib/tours';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: object;
  /** Header floats transparently over a full-screen hero until the page scrolls */
  overlayHeader?: boolean;
  /** Utility pages (404, thank-you) are never indexed */
  noindex?: boolean;
  /** Breadcrumb trail for search engines; worked out from the URL when not given */
  crumbs?: { name: string; href: string }[];
}
const { title, description = site.description, image = '/images/og.jpg', jsonLd, overlayHeader = false, noindex = false, crumbs } = Astro.props;
// Long titles (old column headlines) skip the brand suffix so search results cut them less
const fullTitle = title ? (title.length > 50 ? title : `${title} | ${site.name}`) : `${site.name} | ${site.tagline}`;
// build.format 'file' makes the build-time path end in .html; the live URL has no extension (/tour/slug)
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1') || '/', Astro.site);
const ogImage = new URL(image, Astro.site).toString();
const siteUrl = new URL('/', Astro.site).toString();
const path = canonical.pathname;

// Breadcrumbs (search results show them instead of the raw URL)
const seg = path.split('/').filter(Boolean);
const section: Record<string, { name: string; href: string }> = { tour: { name: 'Tours', href: '/tours' }, area: { name: 'Tours', href: '/tours' }, theme: { name: 'Tours', href: '/tours' }, column: { name: 'Column', href: '/column' } };
const leaf = seg[0] === 'area' ? `${seg[1]} tours` : seg[0] === 'theme' ? THEME_LABELS[seg[1]] ?? seg[1] : (title ?? site.name);
const trail = crumbs ?? (seg.length === 0 ? [] : [
  { name: 'Home', href: '/' },
  ...(seg.length > 1 && section[seg[0]] ? [section[seg[0]]] : []),
  { name: leaf, href: path },
]);

// Who runs the site, the same on every page (logo, social profiles, review pages)
const org = {
  '@type': ['TravelAgency', 'Organization'],
  '@id': `${siteUrl}#org`,
  name: site.name,
  legalName: site.legalName,
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: new URL('/images/brand/icon-512.png', Astro.site).toString(), width: 512, height: 512 },
  image: new URL('/images/og.jpg', Astro.site).toString(),
  description: site.description,
  areaServed: ['Shinjuku', 'Ueno', 'Asakusa'].map((n) => ({ '@type': 'Place', name: `${n}, Tokyo` })),
  address: { '@type': 'PostalAddress', streetAddress: '1-11-1 Marunouchi', addressLocality: 'Chiyoda-ku', addressRegion: 'Tokyo', postalCode: '100-0005', addressCountry: 'JP' },
  email: 'info_ninja-go-ride@ninja-kabukitokyo.com',
  priceRange: '¥2,500–¥8,000',
  currenciesAccepted: 'JPY',
  knowsAbout: ['Shinjuku', 'Kabukicho', 'Golden Gai', 'Hanazono Shrine', 'Shinjuku Nichome', 'Shinjuku Gyoen', 'Ueno Ameyoko', 'Asakusa', 'Kappabashi', 'Japanese hanko seals', 'Shinto shrines', 'Tokyo nightlife'],
  parentOrganization: { '@type': 'Organization', name: site.legalName, alternateName: '株式会社Kiranah Resort' },
  brand: { '@type': 'Brand', name: 'NINJA GO TOURS' },
  sameAs: [site.instagram, site.tiktok, site.googleBusinessProfile, ...reviews.ratings.map((r) => r.url)].filter((u) => u && !u.includes('/maps/search/')),
};
const graph = [
  { '@type': 'WebSite', '@id': `${siteUrl}#website`, url: siteUrl, name: site.name, alternateName: ['NINJA GO TOURS Tokyo', 'Ninja Go Tours'], inLanguage: 'en', publisher: { '@id': `${siteUrl}#org` } },
  org,
  ...(trail.length > 1 ? [{ '@type': 'BreadcrumbList', itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, Astro.site).toString() })) }] : []),
];

// Page facts for analytics (GA4 custom dimensions via the dataLayer)
const pageType = seg.length === 0 ? 'home' : seg[0] === 'tour' ? 'tour' : seg[0] === 'column' ? (seg[1] ? 'column' : 'column_list') : seg[0] === 'tours' || seg[0] === 'area' || seg[0] === 'theme' ? 'tour_list' : 'other';
// Search engines may index the site only on the real domain in production (not on *.netlify.app previews)
const indexable = process.env.CONTEXT === 'production' && /(^|\/\/)(www\.)?ninjagotours\.com/.test(process.env.URL ?? '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {(!indexable || noindex)
      ? <meta name="robots" content={noindex && indexable ? 'noindex' : 'noindex, nofollow'} />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline define:vars={{ pageType, tourId: seg[0] === 'tour' ? seg[1] : undefined }}>
      window.dataLayer = window.dataLayer || []; window.dataLayer.push({ page_type: pageType, tour_id: tourId });
    </script>
    {site.gtmId ? (
      <script is:inline define:vars={{ id: site.gtmId, live: indexable }}>
        if (live || /[?&]gtm_debug=/.test(location.search)) (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
      </script>
    ) : site.ga4MeasurementId ? (
      <>
        <script is:inline define:vars={{ id: site.ga4MeasurementId, live: indexable }}>
          if (live) { var g = document.createElement('script'); g.async = true; g.src = 'https://www.googletagmanager.com/gtag/js?id=' + id; document.head.appendChild(g);
            window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};gtag('js',new Date());gtag('config',id,{linker:{domains:['ninjagotours.com','triplabo.com']}}); }
        </script>
      </>
    ) : null}
  </head>
  <body>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll motion: reveal / wipe / stamp elements as they enter, count numbers up, and solidify the header.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const countUp = (el: HTMLElement) => {
        const end = Number(el.dataset.count);
        const dec = (el.dataset.count || '').split('.')[1]?.length ?? 0;
        if (reduce) { el.textContent = end.toFixed(dec); return; }
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / 1400);
          el.textContent = (end * (1 - Math.pow(1 - p, 3))).toFixed(dec);
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.classList.add('is-in');
          if (el.dataset.count) countUp(el);
          io.unobserve(el);
        });
      }, { rootMargin: '0px 0px -12% 0px' });
      document.querySelectorAll('[data-reveal],[data-wipe],[data-stamp],[data-count]').forEach((el) => io.observe(el));

      const hdr = document.querySelector('.hdr');
      if (hdr) {
        const onScroll = () => hdr.classList.toggle('is-scrolled', scrollY > 40);
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    </script>
    <script>
      // Live exchange rate: refresh every "≈US$" amount ([data-jpy]) with today's rate, cached for 12 hours.
      import { FX_URLS } from '../lib/fx-sources';
      const KEY = 'ngt-fx';
      const apply = (rate: number) => {
        document.querySelectorAll<HTMLElement>('[data-jpy]').forEach((el) => {
          const [lo, hi] = el.dataset.jpy!.split('-').map(Number);
          const a = Math.round(lo * rate);
          el.textContent = hi ? `≈US$${a}–${Math.round(hi * rate)}` : `≈US$${a}`;
        });
      };
      (async () => {
        if (!document.querySelector('[data-jpy]')) return;
        try {
          const c = JSON.parse(localStorage.getItem(KEY) || 'null');
          if (c && Date.now() - c.t < 12 * 3600e3) return apply(c.r);
        } catch {}
        for (const url of FX_URLS) {
          try {
            const j = await (await fetch(url)).json();
            const r = j?.rates?.USD;
            if (r > 0.001 && r < 0.1) {
              apply(r);
              try { localStorage.setItem(KEY, JSON.stringify({ r, t: Date.now() })); } catch {}
              return;
            }
          } catch {}
        }
      })();
    </script>
    <script>
      // Analytics: any element with data-track sends an event (GA4 via gtag, or GTM via dataLayer).
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (!el) return;
        const params: Record<string, string | undefined> = { ...el.dataset };
        const event = params.track;
        delete params.track;
        // one name for "where on the page" (some buttons say data-where), and the link target for outbound clicks
        if (params.where && !params.location) { params.location = params.where; delete params.where; }
        const href = (el as HTMLAnchorElement).href;
        if (href) { params.link_url = href; params.link_domain = new URL(href, location.href).hostname; }
        const w = window as unknown as { gtag?: (...a: unknown[]) => void; dataLayer?: unknown[] };
        if (typeof w.gtag === 'function') w.gtag('event', event, params);
        else (w.dataLayer = w.dataLayer || []).push({ event, ...params });
      });
    </script>
  </body>
</html>
