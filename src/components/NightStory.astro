---
// Scroll story: the photo stays pinned while the steps scroll past, and swaps as each step comes into view.
import { srcset } from '../lib/img';
interface Step { kicker: string; title: string; text: string; image: string; alt: string }
interface Props { steps: Step[] }
const { steps } = Astro.props;
---
<div class="ns" data-ns>
  <div class="ns__stage" aria-hidden="true">
    {steps.map((s, i) => (
      <img class:list={['ns__img', { 'is-on': i === 0 }]} src={s.image} srcset={srcset(s.image, 1400)} sizes="(max-width: 900px) 100vw, 55vw" alt="" loading="lazy" width="1400" height="1050" data-i={i} />
    ))}
    <div class="ns__count"><span data-ns-count>01</span> / {String(steps.length).padStart(2, '0')}</div>
  </div>
  <ol class="ns__steps">
    {steps.map((s, i) => (
      <li class="ns__step" data-i={i}>
        <img class="ns__mimg" src={s.image} srcset={srcset(s.image, 1400)} sizes="100vw" alt={s.alt} loading="lazy" width="1400" height="1050" />
        <p class="ns__kicker">{s.kicker}</p>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ns]').forEach((ns) => {
    const imgs = ns.querySelectorAll<HTMLElement>('.ns__img');
    const count = ns.querySelector('[data-ns-count]');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const i = Number((e.target as HTMLElement).dataset.i);
        imgs.forEach((im, k) => im.classList.toggle('is-on', k === i));
        ns.querySelectorAll('.ns__step').forEach((st, k) => st.classList.toggle('is-active', k === i));
        if (count) count.textContent = String(i + 1).padStart(2, '0');
      });
    }, { rootMargin: '-45% 0px -45% 0px' });
    ns.querySelectorAll('.ns__step').forEach((st) => io.observe(st));
  });
</script>

<style>
  .ns { display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; align-items: start; }
  .ns__stage { position: sticky; top: 12vh; height: 76vh; border-radius: 28px; overflow: hidden; background: var(--night-3); box-shadow: 0 30px 80px rgb(0 0 0 / 0.45); }
  .ns__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.08); transition: opacity 0.9s ease, transform 2.4s ease; }
  .ns__img.is-on { opacity: 1; transform: scale(1); }
  .ns__count { position: absolute; left: 22px; bottom: 16px; font-family: var(--display); color: #fff; font-size: 1rem; text-shadow: 0 2px 10px rgb(0 0 0 / 0.6); }
  .ns__count span { font-size: 2.6rem; color: var(--lantern); }
  .ns__steps { list-style: none; margin: 0; padding: 18vh 0; display: grid; gap: 34vh; }
  .ns__step { opacity: 0.28; transition: opacity 0.5s; }
  .ns__step.is-active { opacity: 1; }
  .ns__kicker { font-weight: 800; color: var(--lantern); letter-spacing: 0.12em; margin: 0 0 8px; }
  .ns__step h3 { font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .ns__step p { color: #d6cebf; font-size: 1.05rem; }
  .ns__mimg { display: none; }
  @media (max-width: 900px) {
    .ns { grid-template-columns: 1fr; }
    .ns__stage { display: none; }
    .ns__steps { padding: 0; gap: 48px; }
    .ns__step { opacity: 1; }
    .ns__mimg { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 20px; margin-bottom: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .ns__img { transition: none; } }
</style>
