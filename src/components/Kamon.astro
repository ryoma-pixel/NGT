---
// The tour's family crest (src/lib/kamon.ts). Decoration only.
import { KAMON } from '../lib/kamon';
interface Props { name?: string; size?: number; class?: string }
const { name, size = 44, class: cls } = Astro.props;
const k = KAMON[name ?? ''];
---
{k && <svg class:list={['kamon', cls]} viewBox="0 0 100 100" width={size} height={size} aria-hidden="true" set:html={k.svg} />}

<style>
  .kamon { flex: none; color: var(--cream); --kamon-bg: var(--night); }
</style>
