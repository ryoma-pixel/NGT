---
// Horizontal "choose your mission" rail of tour cards with scroll-snap and arrow buttons.
import TourCard from './TourCard.astro';
import type { Tour } from '../lib/tours';
interface Props { tours: Tour[] }
const { tours } = Astro.props;
---
<div class="rail" data-rail>
  <div class="rail__track" tabindex="0" aria-label="Tours, scroll sideways">
    {tours.map((t, i) => (
      <div class="rail__item">
        <p class="rail__num" aria-hidden="true">MISSION <span>{String(i + 1).padStart(2, '0')}</span></p>
        <TourCard tour={t} />
      </div>
    ))}
    <a class="rail__all" href="/tours">
      <span class="rail__all-kanji" aria-hidden="true">全</span>
      <span>See all tours →</span>
    </a>
  </div>
  <div class="rail__ctrl">
    <button type="button" class="rail__btn" data-dir="-1" aria-label="Previous tours">←</button>
    <button type="button" class="rail__btn" data-dir="1" aria-label="Next tours">→</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('.rail__track')!;
    rail.querySelectorAll<HTMLButtonElement>('.rail__btn').forEach((b) =>
      b.addEventListener('click', () => {
        const step = (track.querySelector('.rail__item') as HTMLElement).offsetWidth + 20;
        track.scrollBy({ left: Number(b.dataset.dir) * step, behavior: 'smooth' });
      }),
    );
  });
</script>

<style>
  .rail__track { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: max(16px, calc((100vw - var(--max)) / 2 + 16px)); padding: 8px max(16px, calc((100vw - var(--max)) / 2 + 16px)) 24px; scrollbar-width: none; }
  .rail__track::-webkit-scrollbar { display: none; }
  .rail__item { flex: none; width: min(78vw, 360px); scroll-snap-align: start; }
  .rail__num { margin: 0 0 8px; font-family: var(--display); font-size: 0.8rem; letter-spacing: 0.18em; color: var(--ink-2); }
  .rail__num span { color: var(--shu-dark); font-size: 1.3rem; }
  .rail__all { flex: none; width: min(60vw, 240px); margin-top: 30px; border-radius: var(--radius); border: 2px dashed var(--line); display: grid; place-items: center; align-content: center; gap: 10px; text-decoration: none; font-weight: 700; scroll-snap-align: start; transition: background 0.3s; }
  .rail__all:hover { background: var(--card); }
  .rail__all-kanji { font-family: var(--display); font-size: 4rem; color: var(--shu); line-height: 1; }
  .rail__ctrl { display: flex; gap: 10px; justify-content: flex-end; max-width: var(--max); margin: 0 auto; padding: 0 16px; }
  .rail__btn { width: 52px; height: 52px; border-radius: 50%; border: 2px solid var(--ink); background: transparent; font-size: 1.3rem; cursor: pointer; transition: background 0.2s, color 0.2s; }
  .rail__btn:hover { background: var(--ink); color: #fff; }
  @supports (animation-timeline: view()) {
    .rail__item { animation: rail-in linear both; animation-timeline: view(inline); animation-range: entry 0% entry 60%; }
    @keyframes rail-in { from { transform: scale(0.9) rotate(2deg); } }
  }
</style>
