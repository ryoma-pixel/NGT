---
// Ukiyo-e style character portrait for the quiz dialogue: the Lord (殿) and your Ninja (忍).
// The picture sits in a framed print with a small vertical name slip, like the cartouche on a woodblock print.
// Images: public/images/characters/<who>-240.webp / -480.webp (made by scripts/make-character.py). Illustration only.
interface Props { who: 'lord' | 'ninja'; class?: string }
const { who, class: cls } = Astro.props;
const name = who === 'lord' ? '殿' : '忍';
const base = `/images/characters/${who}`;
---
<span class:list={['pt', `pt--${who}`, cls]} aria-hidden="true">
  <span class="pt__pic"><img src={`${base}-240.webp`} srcset={`${base}-240.webp 240w, ${base}-480.webp 480w`} sizes="96px" width="240" height="300" alt="" loading="lazy" decoding="async" /></span>
  <b class="pt__name">{name}</b>
</span>

<style>
  .pt { position: relative; flex: none; display: block; width: 100px; aspect-ratio: 4 / 5; }
  .pt__pic { position: absolute; inset: 0; overflow: hidden; border: 2px solid var(--ai); border-radius: 8px; background: #ecdfc1; box-shadow: 0 4px 0 var(--ai); }
  .pt--ninja .pt__pic { border-color: #14151f; box-shadow: 0 4px 0 #14151f; }
  .pt__pic img { display: block; width: 100%; height: 100%; object-fit: cover; transform-origin: 50% 85%; }
  /* the name slip (cartouche) on the outer top corner */
  .pt__name { position: absolute; top: 5px; left: 5px; z-index: 1; writing-mode: vertical-rl; font-family: var(--mincho); font-weight: 800; font-size: 0.95rem; line-height: 1; padding: 5px 3px; background: var(--cream); color: var(--ai); border: 1.5px solid var(--ai); border-radius: 3px; box-shadow: 0 2px 0 var(--ai); }
  .pt--ninja .pt__name { left: auto; right: 5px; background: #14151f; color: var(--cream); border-color: #14151f; box-shadow: 0 2px 0 #000; }
  @media (max-width: 900px) { .pt { width: 64px; } .pt__name { font-size: 0.72rem; padding: 3px 2px; top: 3px; left: 3px; } .pt--ninja .pt__name { left: auto; right: 3px; } }
</style>
