---
import reviews from '../data/reviews.json';
---
<section class="section section--dark rv" id="reviews">
  <div class="wrap">
    <p class="eyebrow"><span class="jp">お客様の声</span> Guest voices</p>
    <h2>Smiles from our guests</h2>
    <ul class="rv__scores">
      {reviews.ratings.map((r) => (
        <li><a href={r.url} rel="noopener" target="_blank" data-track="click_review_source" data-source={r.source}>
          <strong>{r.score.toFixed(1)}</strong><span class="rv__stars" aria-hidden="true">★★★★★</span>
          <span>{r.source}{r.label ? ` · ${r.label}` : ''} · {r.count} reviews</span>
        </a></li>
      ))}
    </ul>
    <div class="rv__list">
      {reviews.items.map((r) => (
        <figure class="rv__item">
          <span class="rv__stars" aria-label={`${r.stars} out of 5 stars`}>{'★'.repeat(r.stars)}</span>
          <blockquote>“{r.text}”</blockquote>
          <figcaption>{r.author} — {r.source} review{r.tour ? ` (${r.tour})` : ''}</figcaption>
        </figure>
      ))}
    </div>
    <p class="rv__note">{reviews.note}</p>
  </div>
</section>

<style>
  .rv__scores { list-style: none; padding: 0; margin: 8px 0 28px; display: flex; flex-wrap: wrap; gap: 14px; }
  .rv__scores a { display: flex; align-items: baseline; gap: 10px; padding: 12px 18px; border-radius: 14px; background: rgb(255 255 255 / 0.06); border: 1px solid rgb(255 255 255 / 0.12); color: var(--cream); text-decoration: none; }
  .rv__scores strong { font-family: var(--display); font-size: 1.6rem; color: var(--lantern); }
  .rv__scores span:last-child { font-size: 0.85rem; opacity: 0.8; }
  .rv__stars { color: var(--lantern); letter-spacing: 2px; }
  .rv__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
  .rv__item { margin: 0; padding: 22px; border-radius: var(--radius); background: var(--cream); color: var(--ink); display: flex; flex-direction: column; gap: 10px; }
  .rv__item blockquote { margin: 0; font-size: 1rem; line-height: 1.55; flex: 1; }
  .rv__item figcaption { font-size: 0.85rem; color: var(--muted); font-weight: 600; }
  .rv__note { margin-top: 18px; font-size: 0.8rem; color: rgb(247 240 227 / 0.6); }
</style>
