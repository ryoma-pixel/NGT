---
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
---
<header class:list={['hdr', { 'hdr--overlay': overlay }]}>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo">
      <img class="hdr__mark" src="/images/brand/logo-light-96.webp" alt="" width="48" height="48" />
      <span class="hdr__name">NINJA GO TOURS</span>
    </a>
    <nav class="hdr__nav" aria-label="Main">
      <a href="/tours">Tours</a>
      <a href="/#faq">FAQ</a>
      <a href="/contact">Contact</a>
    </nav>
    <a href="/tours" class="btn btn--primary hdr__cta" data-track="click_header_cta">Find your tour</a>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgb(13 15 28 / 0.88); backdrop-filter: blur(10px); color: var(--cream); border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .hdr { transition: background 0.3s, box-shadow 0.3s; }
  /* over the hero: no border at all (a transparent border let the gradient repeat into it as a dark line) */
  .hdr--overlay { position: fixed; left: 0; right: 0; background: linear-gradient(rgb(8 8 18 / 0.55), rgb(8 8 18 / 0)); border-bottom: 0; backdrop-filter: none; }
  .hdr--overlay.is-scrolled { background: rgb(13 15 28 / 0.9); backdrop-filter: blur(10px); box-shadow: 0 1px 0 rgb(255 255 255 / 0.08); }
  .hdr__in { display: flex; align-items: center; gap: 16px; height: 68px; }
  .hdr__logo { display: flex; align-items: center; gap: 10px; text-decoration: none; white-space: nowrap; }
  .hdr__mark { width: 48px; height: 48px; border-radius: 50%; transition: transform 0.4s cubic-bezier(.2,.7,.2,1); }
  .hdr__logo:hover .hdr__mark { transform: rotate(-12deg); }
  .hdr__name { font-family: var(--display); font-weight: 400; font-size: 1.25rem; color: var(--cream); letter-spacing: 0.04em; }
  .hdr__nav { display: flex; gap: 22px; margin-left: auto; font-family: var(--mono); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .hdr__nav a { text-decoration: none; color: rgb(247 240 227 / 0.85); }
  .hdr__nav a:hover { color: var(--lantern); }
  .hdr__cta { padding: 0.6em 1.1em; font-size: 0.9rem; box-shadow: 0 3px 0 var(--book-dark); white-space: nowrap; }
  @media (max-width: 720px) {
    .hdr__nav { display: none; }
    .hdr__cta { margin-left: auto; }
    .hdr__name { font-size: 1.05rem; letter-spacing: 0.02em; }
    .hdr__cta { padding: 0.55em 0.9em; font-size: 0.85rem; }
    .hdr__mark { width: 42px; height: 42px; }
  }
</style>
