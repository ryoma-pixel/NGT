---
import site from '../data/site.json';
import { AREAS } from '../lib/tours';
---
<footer class="ftr">
  <div class="wrap ftr__grid">
    <div>
      <p class="ftr__brand"><img src="/images/brand/logo-light-160.webp" alt="" width="80" height="80" loading="lazy" decoding="async" /> NINJA GO TOURS</p>
      <p class="ftr__small">{site.tagline}. Operated by {site.operator}{site.operator.endsWith('.') ? '' : '.'}</p>
    </div>
    <div>
      <p class="ftr__h">Tours by area</p>
      <ul>
        {AREAS.map((a) => <li><a href={`/area/${a}`}>{a}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="ftr__h">Info</p>
      <ul>
        <li><a href="/tours">All tours</a></li>
        <li><a href="/column">Column</a></li>
        <li><a href="/contact">Contact us</a></li>
        <li><a href="/term">Terms of Use</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/about">Legal Notice</a></li>
        <li><a href="/site-map">Site map</a></li>
      </ul>
    </div>
    <div>
      <p class="ftr__h">Follow</p>
      <ul>
        <li><a href={site.instagram} rel="noopener">Instagram</a></li>
        <li><a href={site.tiktok} rel="noopener">TikTok</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap ftr__copy">© {new Date().getFullYear()} {site.operator}</div>
</footer>

<style>
  .ftr { background: var(--night) var(--seigaiha); color: #cfc6b6; padding: 48px 0 24px; margin-top: 0; }
  .ftr__grid { display: grid; gap: 28px; grid-template-columns: 2fr repeat(3, 1fr); }
  .ftr__brand { display: flex; align-items: center; gap: 14px; font-family: var(--display); font-weight: 400; color: #fff; font-size: 1.2rem; margin-bottom: 0.6em; }
  .ftr__small { font-size: 0.9rem; }
  .ftr__h { color: #fff; font-weight: 700; margin-bottom: 0.4em; }
  .ftr ul { list-style: none; margin: 0; padding: 0; }
  .ftr li { margin: 0.3em 0; }
  .ftr a { text-decoration: none; }
  .ftr a:hover { text-decoration: underline; }
  .ftr__copy { border-top: 1px solid var(--night-3); margin-top: 32px; padding-top: 16px; font-size: 0.85rem; }
  @media (max-width: 720px) { .ftr__grid { grid-template-columns: 1fr 1fr; } .ftr__grid > div:first-child { grid-column: 1 / -1; } }
</style>
