---
// "Produced by Ninja + Kabuki Tokyo": the house behind NINJA GO TOURS, with review ratings as proof.
// A kabuki curtain (joshiki-maku: black, persimmon, green) is drawn aside when the section comes into view.
// The rating shown is Ninja + Kabuki Tokyo's own (src/data/reviews.json > producer.rating, editable in Pages CMS).
import reviews from '../data/reviews.json';
const p = reviews.producer;
type Plaque = { score: number; source: string; who: string; count: string; url: string };
const plaques: Plaque[] = [
  { score: p.rating.score, source: p.rating.source, who: p.name, count: `${p.rating.countLabel} reviews`, url: p.rating.url },
];
---
<section class="nkt" id="produced-by" aria-labelledby="nkt-h" data-nkt>
  <div class="nkt__maku" aria-hidden="true"><span></span></div>
  <div class="wrap nkt__in">
    <div class="nkt__logo">
      <span class="nkt__tate" aria-hidden="true">座元</span>
      <img src="/images/brand/nkt-logo-white.webp" width="600" height="456" alt="Ninja + Kabuki Tokyo" loading="lazy" decoding="async" />
    </div>
    <div class="nkt__text">
      <p class="eyebrow">The house behind the Ninja</p>
      <h2 id="nkt-h">Produced by <span>Ninja + Kabuki Tokyo.</span></h2>
      <p class="nkt__lead">NINJA GO TOURS is produced by {p.name}, {p.about}. See the show on the stage. Walk the city with a Ninja.</p>
      <ul class="nkt__plaques" role="list">
        {plaques.map((q, i) => (
          <li style={`--i:${i}`}>
            <a class="nkt__plaque" href={q.url} target="_blank" rel="noopener" data-track="click_rating" data-source={q.source}>
              <span class="nkt__score">{q.score.toFixed(1)}<i aria-hidden="true">★</i></span>
              <span class="nkt__src">{q.source}</span>
              <span class="nkt__who">{q.who}</span>
              <span class="nkt__count">{q.count}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="btn nkt__go" href={p.url} target="_blank" rel="noopener" data-track="click_nkt" data-where="home_producer">Visit {p.name} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-nkt]').forEach((sec) => {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { sec.classList.add('is-open'); io.disconnect(); } }), { threshold: 0.35 });
    io.observe(sec);
  });
</script>

<style>
  .nkt { --kaki: #9b5230; --moegi: #3d5a36; --sumi: #141418; position: relative; overflow: hidden; background: var(--night) var(--seigaiha); color: var(--cream); padding: 88px 0 72px; isolation: isolate; }
  /* the striped band of the curtain stays along the top once it is drawn aside */
  .nkt::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 14px; z-index: 1;
    background: repeating-linear-gradient(90deg, var(--sumi) 0 56px, var(--kaki) 56px 112px, var(--moegi) 112px 168px); }
  /* joshiki-maku: covers the stage, then is pulled aside to the left */
  .nkt__maku { position: absolute; inset: 0; z-index: 3; pointer-events: none; transform: translateX(-101%);
    background: repeating-linear-gradient(90deg, var(--sumi) 0 11%, var(--kaki) 11% 22%, var(--moegi) 22% 33.33%); }
  .nkt__maku span { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, rgb(0 0 0 / 0.22) 0 2px, transparent 2px 22px), linear-gradient(180deg, rgb(255 255 255 / 0.06), transparent 30%, rgb(0 0 0 / 0.3)); }
  :global(.js) .nkt:not(.is-open) .nkt__maku { transform: none; }
  .nkt__maku { transition: transform 1.5s cubic-bezier(.65,0,.3,1) 0.15s; }

  .nkt__in { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 32px 56px; align-items: center; }
  .nkt__logo { position: relative; display: grid; place-items: center; padding: 20px; }
  .nkt__logo::before { content: ''; position: absolute; inset: 6% 10%; border-radius: 50%; background: radial-gradient(circle, rgb(247 240 227 / 0.14), transparent 65%); }
  .nkt__logo img { position: relative; width: min(100%, 420px); height: auto; filter: drop-shadow(0 10px 30px rgb(0 0 0 / 0.5)); }
  .nkt__tate { position: absolute; top: 0; left: 0; writing-mode: vertical-rl; font-family: var(--mincho); font-weight: 800; font-size: 1rem; letter-spacing: 0.15em; padding: 6px 4px; background: var(--cream); color: var(--ai); border: 2px solid var(--cream); box-shadow: inset 0 0 0 1.5px var(--ai); }

  .nkt .eyebrow { color: #e7c465; }
  .nkt h2 { font-size: clamp(2.3rem, 4.6vw, 4rem); line-height: 0.98; margin: 0 0 14px; }
  .nkt h2 span { color: transparent; -webkit-text-stroke: 2px var(--cream); }
  .nkt__lead { margin: 0 0 26px; max-width: 48ch; color: rgb(247 240 227 / 0.86); font-size: 1.05rem; }

  /* rating plaques: gold wooden tags, like votive plaques at a shrine */
  .nkt__plaques { list-style: none; margin: 0 0 26px; padding: 0; display: grid; grid-template-columns: minmax(0, 260px); gap: 12px; }
  .nkt__plaque { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; height: 100%; padding: 16px 14px 14px; color: #2c1d06; text-decoration: none; border-radius: 6px 6px 10px 10px;
    background: linear-gradient(160deg, #f6dc8f, #e0b95a 45%, #c99a3e); box-shadow: inset 0 0 0 2px rgb(255 240 190 / 0.6), inset 0 0 0 4px rgb(90 60 10 / 0.35), 0 8px 20px rgb(0 0 0 / 0.35); transition: transform 0.25s cubic-bezier(.3,1.5,.5,1); }
  .nkt__plaque::before { content: ''; position: absolute; top: 7px; left: 50%; width: 8px; height: 8px; margin-left: -4px; border-radius: 50%; background: #5a3c0a; box-shadow: inset 0 1px 1px rgb(0 0 0 / 0.5); }
  .nkt__plaque:hover, .nkt__plaque:focus-visible { transform: translateY(-4px) rotate(-1deg); outline: none; }
  .nkt__score { font-family: var(--display); font-size: 2.6rem; line-height: 1; margin-top: 4px; }
  .nkt__score i { font-style: normal; font-size: 1.3rem; vertical-align: 0.9em; margin-left: 2px; }
  .nkt__src { font-family: var(--mono); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .nkt__who { font-weight: 700; font-size: 0.86rem; line-height: 1.25; }
  .nkt__count { margin-top: auto; padding-top: 6px; font-family: var(--mono); font-size: 0.72rem; }
  .nkt__go { border: 2px solid var(--cream); color: var(--cream); background: transparent; }
  .nkt__go:hover { background: var(--cream); color: var(--ai); }

  /* entrance: plaques hang in one by one after the curtain opens */
  :global(.js) .nkt:not(.is-open) .nkt__plaques li, :global(.js) .nkt:not(.is-open) .nkt__logo img { opacity: 0; }
  .nkt__plaques li { transition: opacity 0.5s calc(1.3s + var(--i) * 0.15s), transform 0.6s cubic-bezier(.3,1.5,.5,1) calc(1.3s + var(--i) * 0.15s); transform-origin: 50% 0; }
  :global(.js) .nkt:not(.is-open) .nkt__plaques li { transform: translateY(-14px) rotate(-6deg); }
  .nkt__logo img { transition: opacity 0.8s 1s; }

  @media (max-width: 900px) {
    .nkt { padding: 72px 0 56px; }
    .nkt__in { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .nkt__logo img { width: min(70%, 300px); }
    .nkt__tate { font-size: 0.85rem; }
    .nkt__plaques { grid-template-columns: minmax(0, 240px); }
    .nkt__plaque { padding: 14px 10px 10px; }
    .nkt__score { font-size: 2rem; }
    .nkt__who { font-size: 0.74rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nkt__maku { display: none; }
    .nkt__plaques li, .nkt__logo img, .nkt__plaque { transition: none; }
    :global(.js) .nkt:not(.is-open) .nkt__plaques li, :global(.js) .nkt:not(.is-open) .nkt__logo img { opacity: 1; transform: none; }
  }
</style>
