---
import { ICONS, type IconName } from './icons';

interface Props { name: IconName; size?: number; class?: string; label?: string }
const { name, size = 24, class: cls, label } = Astro.props;
---
<svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={ICONS[name]} />
