---
// A friendly chat between a traveler and a Ninja guide: the "smiles and conversation" at the heart of every tour.
interface Line { who: 'guest' | 'ninja'; text: string }
interface Props { lines: Line[]; photo?: string; photoAlt?: string }
const { lines, photo, photoAlt = '' } = Astro.props;
---
<div class="dlg">
  {photo && <img class="dlg__photo" src={photo} alt={photoAlt} width="720" height="720" />}
  <ol class="dlg__lines">
    {lines.map((l, i) => (
      <li class={`dlg__line dlg__line--${l.who}`} style={`--i:${i}`}>
        <span class="dlg__avatar" aria-hidden="true">{l.who === 'ninja' ? '忍' : 'Hi'}</span>
        <span class="visually-hidden">{l.who === 'ninja' ? 'Ninja guide:' : 'Guest:'}</span>
        <p class="dlg__bubble">{l.text}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .dlg { position: relative; background: linear-gradient(rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.7)), var(--seigaiha), #fff; border-radius: 28px; padding: 28px 22px; box-shadow: var(--shadow); overflow: hidden; }
  .dlg__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dlg__photo + .dlg__lines { position: relative; }
  .dlg__lines { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .dlg__line { display: flex; align-items: flex-end; gap: 10px; animation: pop 0.5s both; animation-delay: calc(var(--i) * 0.9s + 0.3s); }
  .dlg__line--ninja { flex-direction: row-reverse; }
  .dlg__avatar { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 0.85rem; border: 3px solid #fff; box-shadow: 0 2px 6px rgb(0 0 0 / 0.1); }
  .dlg__line--guest .dlg__avatar { background: var(--ai); color: #fff; }
  .dlg__line--ninja .dlg__avatar { background: var(--shu); color: #fff; font-family: var(--display); font-size: 1rem; }
  .dlg__bubble { margin: 0; padding: 12px 16px; border-radius: 20px; max-width: 80%; font-size: 0.98rem; line-height: 1.45; box-shadow: 0 2px 8px rgb(60 40 20 / 0.08); }
  .dlg__line--guest .dlg__bubble { background: #eef2f9; border-bottom-left-radius: 6px; }
  .dlg__line--ninja .dlg__bubble { background: var(--sakura); border-bottom-right-radius: 6px; }
  @keyframes pop { from { opacity: 0; transform: translateY(10px) scale(0.96); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .dlg__line { animation: none; } }
</style>
