---
// Picture scroll (emaki), woodblock-print style: scrolling down slides a long sheet of paper sideways.
// Each scene: a huge minute number, a vertical Japanese word, a framed photo (ink-black until it reaches the centre,
// then it turns to colour) and one short line. A 60-minute ruler at the bottom tracks progress.
// Without JS or with reduced motion it is a plain sideways list.
import Tate from './Tate.astro';
import Kamon from './Kamon.astro';
import { srcset } from '../lib/img';
import { patternBg } from '../lib/patterns';
interface Scene { kicker: string; title: string; text: string; image: string; alt: string; tate?: string }
interface Props {
  scenes: Scene[];
  cover: { title: string; sub: string; tate: string };
  end: { title: string; cta: string; href: string };
  kamon?: string;
  pattern?: string;
}
const { scenes, cover, end, kamon, pattern } = Astro.props;
const bigNum = (k: string) => k.match(/^\d+/)?.[0] ?? '';
---
<section class="emk" data-emaki aria-label="A night with your Ninja, told as a picture scroll">
  <div class="emk__pin">
    <div class="wrap emk__head">
      <p class="eyebrow">A night with your Ninja</p>
      <p class="emk__count" aria-hidden="true"><span data-emk-count>00</span> / {String(scenes.length).padStart(2, '0')}</p>
    </div>
    <div class="emk__stage">
      <div class="emk__track" data-emk-track style={`--pat:${patternBg(pattern, '#1f2d52', 0.55)}`}>
        <div class="emk__cover">
          <Tate text={cover.tate} class="emk__tate" />
          <div class="emk__cover-txt">
            <Kamon name={kamon} size={64} class="emk__kamon" />
            <h2 class="emk__title">{cover.title}</h2>
            <p class="emk__sub">{cover.sub}</p>
            <p class="emk__hint" aria-hidden="true">Scroll →</p>
          </div>
        </div>
        <ol class="emk__scenes">
          {scenes.map((s, i) => (
            <li class:list={['emk__scene', { 'emk__scene--low': i % 2 === 1 }]} data-emk-scene data-kicker={s.kicker}>
              <span class="emk__num" aria-hidden="true">{bigNum(s.kicker)}</span>
              <div class="emk__art">
                <figure class="emk__fig">
                  <img src={s.image} srcset={srcset(s.image, 1400)} sizes="(max-width: 700px) 80vw, 36vw" alt={s.alt} width="1400" height="1050" loading="lazy" />
                </figure>
                {s.tate && <Tate text={s.tate} class="emk__word" />}
              </div>
              <div class="emk__txt">
                <p class="emk__kicker">{s.kicker}</p>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
          <li class="emk__end">
            <p class="emk__end-t">{end.title}</p>
            <a class="btn btn--primary" href={end.href} data-track="click_emaki_book">{end.cta}</a>
          </li>
        </ol>
      </div>
    </div>
    <div class="wrap emk__ruler" aria-hidden="true">
      <span class="emk__rl">00</span>
      <span class="emk__bar"><span class="emk__fill" data-emk-fill></span></span>
      <span class="emk__rl">60 min</span>
      <span class="emk__now" data-emk-now></span>
    </div>
  </div>
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-emaki]').forEach((sec) => {
    if (reduce.matches) return;
    const track = sec.querySelector<HTMLElement>('[data-emk-track]')!;
    const stage = track.parentElement!;
    const count = sec.querySelector('[data-emk-count]');
    const fill = sec.querySelector<HTMLElement>('[data-emk-fill]');
    const now = sec.querySelector<HTMLElement>('[data-emk-now]');
    const scenes = [...sec.querySelectorAll<HTMLElement>('[data-emk-scene]')];
    let startX = 0, dist = 0, ticking = false, last = -1;

    const measure = () => {
      sec.classList.add('is-pinned');
      const sw = stage.clientWidth;
      startX = sw * (sw < 700 ? 0.04 : 0.06);
      dist = Math.max(0, startX + track.scrollWidth - sw);
      sec.style.height = `${dist + innerHeight}px`;
      update();
    };
    const update = () => {
      ticking = false;
      const r = sec.getBoundingClientRect();
      const total = sec.offsetHeight - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
      const x = startX - p * dist;
      track.style.transform = `translate3d(${x}px,0,0)`;
      if (fill) fill.style.transform = `scaleX(${p})`;
      const mid = stage.clientWidth * 0.5;
      let active = -1;
      scenes.forEach((s, i) => {
        const left = x + s.offsetLeft; // offsetLeft is measured from the track
        if (left < mid) active = i;
      });
      if (active !== last) {
        last = active;
        scenes.forEach((s, i) => s.classList.toggle('is-lit', i === active));
        if (count) count.textContent = String(active + 1).padStart(2, '0');
        if (now) now.textContent = active >= 0 ? scenes[active].dataset.kicker ?? '' : '';
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    measure();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', measure);
    addEventListener('load', measure);
  });
</script>

<style>
  .emk { position: relative; background: var(--night); color: var(--cream); }
  .emk__pin { padding: 56px 0 40px; }
  .emk.is-pinned .emk__pin { position: sticky; top: 0; height: 100svh; padding: 84px 0 22px; display: flex; flex-direction: column; overflow: hidden; }
  .emk .eyebrow { color: rgb(247 240 227 / 0.8); }
  .emk__head { display: flex; justify-content: space-between; align-items: baseline; width: 100%; }
  .emk__count { margin: 0; font-family: var(--mono); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em; color: rgb(247 240 227 / 0.6); }
  .emk__count span { font-family: var(--display); font-weight: 400; font-size: 2rem; color: var(--cream); }
  .emk__stage { position: relative; flex: 1; min-height: 0; overflow-x: auto; scrollbar-width: none; margin-top: 6px; }
  .emk.is-pinned .emk__stage { overflow: hidden; }

  /* One long sheet: flat paper, a strip of the tour's pattern along the top like mounting silk, ink rules like a print frame */
  .emk__track { position: relative; display: flex; height: 100%; width: max-content; will-change: transform; background: #f2eadb; color: var(--ai);
    border-top: 16px solid var(--ai); box-shadow: inset 0 3px 0 var(--cream), inset 0 6px 0 var(--ai), inset 0 -6px 0 var(--ai), inset 0 -9px 0 var(--cream), inset 0 -11px 0 var(--ai); }
  .emk__track::before { content: ''; position: absolute; left: 0; right: 0; top: -16px; height: 16px; background: var(--cream) var(--pat); opacity: 0.9; }

  /* Title panel */
  .emk__cover { flex: none; display: flex; align-items: center; gap: 28px; padding: 0 56px 0 48px; border-right: 2px solid var(--ai); }
  .emk__cover :global(.emk__tate) { position: static; font-size: clamp(3.2rem, 7vh, 5.4rem); letter-spacing: 0.12em; padding-top: 0; background: none; color: var(--ai); }
  .emk__cover-txt { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; max-width: 250px; }
  .emk__cover :global(.emk__kamon) { color: var(--ai); --kamon-bg: #f2eadb; }
  .emk__title { font-size: clamp(2.2rem, 4.4vw, 3.4rem); line-height: 0.92; margin: 0; color: var(--ai); }
  .emk__sub { margin: 0; font-family: var(--mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .emk__hint { margin: 10px 0 0; font-family: var(--mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; animation: nudge 1.6s ease-in-out infinite; }
  @keyframes nudge { 50% { transform: translateX(8px); } }

  /* Scenes */
  .emk__scenes { list-style: none; margin: 0; padding: 0; display: flex; }
  .emk__scene { position: relative; flex: none; width: min(46vw, 600px); padding: 5vh 48px 5vh 40px; display: flex; flex-direction: column; justify-content: center; gap: 20px; border-right: 1px solid rgb(31 45 82 / 0.25); }
  .emk__scene--low { flex-direction: column-reverse; }
  .emk__num { position: absolute; bottom: 2vh; right: 20px; font-family: var(--display); font-size: clamp(6rem, 17vh, 11rem); line-height: 0.8; color: transparent; -webkit-text-stroke: 1.5px rgb(31 45 82 / 0.28); pointer-events: none; }
  .emk__scene--low .emk__num { bottom: auto; top: 2vh; }
  .emk__art { position: relative; display: flex; align-items: flex-start; gap: 16px; }
  .emk__fig { position: relative; flex: 1; margin: 0; height: clamp(180px, 36vh, 380px); border: 3px solid var(--ai); box-shadow: 10px 10px 0 var(--ai); overflow: hidden; background: var(--ai); }
  .emk__fig img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15); opacity: 0.8; transform: scale(1.06); transition: filter 0.8s ease, opacity 0.8s ease, transform 1.4s ease; }
  .emk__scene.is-lit .emk__fig img { filter: none; opacity: 1; transform: none; }
  .emk:not(.is-pinned) .emk__fig img { filter: none; opacity: 1; transform: none; }
  .emk__art :global(.emk__word) { position: static; font-size: clamp(1.5rem, 3.4vh, 2.2rem); letter-spacing: 0.18em; padding-top: 0; background: none; color: var(--ai); }
  .emk__txt { position: relative; }
  .emk__txt h3 { font-size: clamp(1.8rem, 3vw, 2.6rem); text-transform: uppercase; line-height: 1; margin: 8px 0 8px; color: var(--ai); }
  .emk__txt p { margin: 0; color: #463f33; }
  .emk__txt .emk__kicker { display: inline-block; font-family: var(--mono); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.06em; color: var(--cream); background: var(--ai); padding: 3px 8px; }
  .emk__end { flex: none; width: min(40vw, 460px); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 20px; padding: 0 48px; }
  .emk__end-t { font-family: var(--display); text-transform: uppercase; font-size: clamp(2.8rem, 5.4vw, 4.8rem); line-height: 0.92; margin: 0; color: var(--ai); }

  /* 60-minute ruler */
  .emk__ruler { display: none; }
  .emk.is-pinned .emk__ruler { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; width: 100%; margin-top: 14px; font-family: var(--mono); font-weight: 700; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(247 240 227 / 0.7); }
  .emk__bar { position: relative; height: 10px; background: repeating-linear-gradient(90deg, rgb(247 240 227 / 0.35) 0 1px, transparent 1px calc(100% / 12)); border-bottom: 1px solid rgb(247 240 227 / 0.35); }
  .emk__fill { position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--cream); transform-origin: left; transform: scaleX(0); }
  .emk__now { grid-column: 1 / -1; justify-self: center; color: var(--cream); min-height: 1em; }

  @media (max-width: 700px) {
    .emk.is-pinned .emk__pin { padding-top: 76px; }
    .emk__cover { padding: 0 28px 0 24px; gap: 16px; }
    .emk__cover-txt { max-width: 190px; }
    .emk__scene { width: 84vw; padding: 3vh 22px; }
    .emk__fig { height: 30svh; box-shadow: 7px 7px 0 var(--ai); }
    .emk__end { width: 80vw; padding: 0 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .emk__hint { animation: none; }
    .emk__fig img { filter: none; opacity: 1; transform: none; transition: none; }
  }
</style>
