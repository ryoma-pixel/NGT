---
import { fromPrice, yen, type Tour } from '../lib/tours';
import { srcset } from '../lib/img';
import Icon from './Icon.astro';
import Kamon from './Kamon.astro';
import { patternBg } from '../lib/patterns';
interface Props { tour: Tour }
const { tour } = Astro.props;
const d = tour.data;
// Back of the card ("donden-gaeshi" revolving wall): another real photo from the tour and its one-line hook
const secret = d.gallery[1] ?? d.gallery[0];
---
<article class="tc" data-flip>
  <div class="tc__inner">
  <a href={`/tour/${tour.id}`} class="tc__link tc__face" data-track="click_tour_card" data-tour={tour.id}>
    {d.heroImage
      ? <img class="tc__img" src={d.heroImage} srcset={srcset(d.heroImage, 1400)} sizes="(max-width: 700px) 80vw, 380px" alt={d.heroAlt ?? ''} loading="lazy" width="700" height="438" />
      : <div class="tc__img tc__ph" aria-hidden="true"></div>}
    <div class="tc__shade" aria-hidden="true"></div>
    <Kamon name={d.kamon} size={46} class="tc__crest" />
    <div class="tc__body">
      {d.draft && <span class="badge badge--draft">DRAFT</span>}
      <p class="tc__area">{d.area} · {d.durationMinutes} min{d.privateTour ? ' · Private' : ''}</p>
      <h3>{d.shortTitle}</h3>
      {d.tagline ? <p class="tc__tag">{d.tagline}</p> : <p class="tc__sum">{d.summary}</p>}
      {d.features.length > 0 && (
        <ul class="tc__feat">
          {d.features.slice(0, 3).map((f) => <li><Icon name={f.icon} size={16} />{f.label}</li>)}
        </ul>
      )}
      <p class="tc__price"><strong>{yen(fromPrice(tour))}</strong> /person {!d.fixedPricePerPerson && <small>(4+ guests)</small>}<span class="tc__go" aria-hidden="true">→</span></p>
    </div>
  </a>
  {secret && (
    <div class="tc__face tc__back" aria-hidden="true" data-back>
      <img class="tc__img" src={secret.src} srcset={srcset(secret.src, 1400)} sizes="(max-width: 700px) 80vw, 380px" alt={secret.alt} loading="lazy" width="700" height="875" />
      <div class="tc__shade tc__shade--back" aria-hidden="true"></div>
      <div class="tc__pat" aria-hidden="true" style={`background-image:${patternBg(d.pattern, '#f7f0e3', 1.2)}`}></div>
      <div class="tc__body">
        <p class="tc__secret">Secret passage</p>
        <p class="tc__hook">{d.hook ?? d.summary}</p>
        <a class="tc__enter" href={`/tour/${tour.id}`} tabindex="-1" data-track="click_card_secret" data-tour={tour.id}>Enter the mission →</a>
      </div>
    </div>
  )}
  </div>
  {secret && <button type="button" class="tc__flip" aria-pressed="false" aria-label={`Flip the card to see a secret of ${d.shortTitle}`} data-track="card_flip" data-tour={tour.id}><Icon name="shuriken" size={18} /><span>Flip</span></button>}
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-flip]').forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('.tc__flip');
    const back = card.querySelector<HTMLElement>('[data-back]');
    const front = card.querySelector<HTMLElement>('.tc__link');
    if (!btn || !back || !front) return;
    btn.addEventListener('click', () => {
      const on = card.classList.toggle('is-flipped');
      btn.setAttribute('aria-pressed', String(on));
      back.toggleAttribute('aria-hidden', !on);
      front.toggleAttribute('aria-hidden', on);
      front.tabIndex = on ? -1 : 0;
      back.querySelector<HTMLElement>('a')!.tabIndex = on ? 0 : -1;
    });
  });
</script>

<style>
  .tc { position: relative; aspect-ratio: 4 / 5; perspective: 1400px; }
  .tc__inner { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.8s cubic-bezier(.7,0,.2,1); }
  .tc.is-flipped .tc__inner { transform: rotateY(180deg); }
  .tc__face { position: absolute; inset: 0; display: block; border-radius: 6px; overflow: hidden; background: var(--night-2); box-shadow: var(--shadow); color: #fff; text-decoration: none; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .tc__back { transform: rotateY(180deg); }
  .tc :global(.tc__crest) { position: absolute; top: 12px; left: 12px; z-index: 2; filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.55)); }
  .tc__pat { position: absolute; inset: 0; opacity: 0.12; mask-image: linear-gradient(180deg, #000, transparent 55%); -webkit-mask-image: linear-gradient(180deg, #000, transparent 55%); }
  .tc__shade--back { background: linear-gradient(180deg, rgb(10 8 20 / 0.2), rgb(10 8 20 / 0.92) 75%); }
  .tc__secret { display: inline-block; margin: 0 0 12px; font-family: var(--mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; border: 1.5px solid var(--cream); padding: 3px 8px; }
  .tc__hook { font-family: var(--display); font-size: 1.7rem; line-height: 1.05; text-transform: uppercase; margin: 0 0 16px; }
  .tc__enter { font-family: var(--mono); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; color: var(--cream); }
  .tc__flip { position: absolute; z-index: 3; top: 12px; right: 12px; display: inline-flex; align-items: center; gap: 6px; padding: 7px 11px; border: 1.5px solid rgb(247 240 227 / 0.7); border-radius: 4px; background: rgb(13 15 28 / 0.55); backdrop-filter: blur(6px); color: var(--cream); font-family: var(--mono); font-weight: 700; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
  .tc__flip :global(.icon) { transition: transform 0.8s cubic-bezier(.7,0,.2,1); }
  .tc.is-flipped .tc__flip :global(.icon) { transform: rotate(360deg); }
  .tc__flip:hover { background: rgb(13 15 28 / 0.8); }
  @media (prefers-reduced-motion: reduce) { .tc__inner, .tc__flip :global(.icon) { transition: none; } }
  .tc__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s cubic-bezier(.2,.7,.2,1); }
  .tc__ph { background: var(--night-3) var(--seigaiha); }
  .tc:hover .tc__img { transform: scale(1.06); }
  .tc__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / 0) 30%, rgb(10 8 20 / 0.55) 55%, rgb(10 8 20 / 0.92) 100%); }
  .tc__body { position: absolute; left: 0; right: 0; bottom: 0; padding: 20px; }
  .tc__area { margin: 0 0 6px; font-family: var(--mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lantern); }
  .tc__body h3 { margin: 0 0 6px; font-size: 1.55rem; line-height: 1.05; text-transform: uppercase; }
  .tc__sum { font-size: 0.92rem; color: rgb(255 255 255 / 0.82); margin: 0 0 10px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tc__tag { font-family: var(--mono); font-size: 0.85rem; font-weight: 700; line-height: 1.35; color: var(--cream); margin: 0 0 10px; }
  .tc__feat { list-style: none; padding: 0; margin: 0 0 12px; display: flex; flex-wrap: wrap; gap: 6px; }
  .tc__feat li { display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px; border-radius: 999px; background: rgb(255 255 255 / 0.14); backdrop-filter: blur(4px); font-size: 0.75rem; font-weight: 700; }
  .tc__feat :global(.icon) { color: var(--lantern); }
  .tc__price { margin: 0; font-size: 0.85rem; display: flex; align-items: baseline; gap: 4px; flex-wrap: wrap; }
  .tc__price strong { font-size: 1.15rem; }
  .tc__price small { opacity: 0.75; }
  .tc__go { margin-left: auto; width: 34px; height: 34px; border-radius: 50%; background: var(--cream); color: var(--night); display: grid; place-items: center; font-weight: 700; transition: transform 0.3s; }
  .tc:hover .tc__go { transform: translateX(4px); }
</style>
