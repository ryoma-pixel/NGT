---
// Scrolling band styled as a Ninja's cloth headband: stitched edges, a knot with tails, shuriken between words.
interface Props { words: string[]; speed?: string }
const { words, speed = '46s' } = Astro.props;
---
<div class="hb" aria-hidden="true">
  <div class="hb__cloth marquee" style={`--speed:${speed}`}>
    <div class="marquee__track">
      {[0, 1].map(() => words.map((w) => (
        <span class="hb__item">{w}<svg class="hb__star" viewBox="0 0 24 24" width="22" height="22"><path d="M12 1.5l2.6 7.9 7.9 2.6-7.9 2.6L12 22.5l-2.6-7.9L1.5 12l7.9-2.6z" fill="currentColor"/><circle cx="12" cy="12" r="2" fill="#15121d"/></svg></span>
      )))}
    </div>
  </div>
  <svg class="hb__knot" viewBox="0 0 140 170" width="140" height="170">
    <g class="hb__tail hb__tail--a"><path d="M62 70 C 78 100, 70 128, 92 164 L 112 150 C 94 122, 98 96, 80 66 Z" fill="#15121d"/><path d="M68 78 C 80 104, 76 128, 96 158" stroke="#f3b33d" stroke-opacity=".55" stroke-width="2" stroke-dasharray="6 5" fill="none"/></g>
    <g class="hb__tail hb__tail--b"><path d="M76 66 C 100 88, 112 104, 138 120 L 130 142 C 104 124, 90 110, 66 84 Z" fill="#221d2c"/><path d="M80 74 C 102 94, 112 106, 134 128" stroke="#f3b33d" stroke-opacity=".55" stroke-width="2" stroke-dasharray="6 5" fill="none"/></g>
    <rect x="46" y="44" width="46" height="38" rx="12" fill="#221d2c" transform="rotate(-8 69 63)"/>
    <path d="M52 56 q17 -8 34 0 M52 70 q17 8 34 0" stroke="#0a0910" stroke-width="3" fill="none" transform="rotate(-8 69 63)"/>
  </svg>
</div>

<style>
  .hb { position: relative; z-index: 3; margin: -22px -3vw 0; transform: rotate(-1.6deg); }
  .hb__cloth {
    position: relative; padding: 20px 0; color: var(--cream);
    background:
      repeating-linear-gradient(45deg, rgb(255 255 255 / 0.025) 0 2px, transparent 2px 6px),
      linear-gradient(180deg, #221d2c, #15121d 55%, #0f0d16);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.35), inset 0 2px 0 rgb(255 255 255 / 0.06);
  }
  .hb__cloth::before, .hb__cloth::after { content: ''; position: absolute; left: 0; right: 0; border-top: 2px dashed rgb(243 179 61 / 0.55); }
  .hb__cloth::before { top: 7px; }
  .hb__cloth::after { bottom: 7px; }
  .hb__item { display: inline-flex; align-items: center; gap: 0.9em; padding-right: 0.9em; font-family: var(--display); font-size: clamp(1.5rem, 2.8vw, 2.2rem); letter-spacing: 0.04em; line-height: 1.1; }
  .hb__star { color: var(--shu); flex: none; transform: rotate(12deg); }
  .hb__knot { position: absolute; right: 7vw; top: 50%; margin-top: -63px; filter: drop-shadow(0 10px 14px rgb(0 0 0 / 0.4)); }
  .hb__tail { transform-origin: 70px 66px; animation: sway 3.6s ease-in-out infinite alternate; }
  .hb__tail--b { animation-duration: 4.4s; animation-delay: -1s; }
  @keyframes sway { from { transform: rotate(-4deg); } to { transform: rotate(5deg); } }
  @media (max-width: 700px) {
    .hb__knot { right: 2vw; width: 100px; height: 122px; margin-top: -45px; }
  }
  @media (prefers-reduced-motion: reduce) { .hb__tail { animation: none; } }
</style>
