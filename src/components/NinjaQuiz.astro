  @keyframes qz-bomb-fill { to { opacity: 1; } }
  @keyframes qz-bomb-unfill { from { opacity: 1; } to { opacity: 0; } }
  @keyframes qz-bomb-in { from { opacity: 0.9; transform: translate(0, 0) scale(0.08); } to { opacity: 1; transform: translate(var(--tx), var(--ty)) scale(1); } }
  @keyframes qz-bomb-out { from { opacity: 1; transform: translate(var(--tx), var(--ty)) scale(1); } to { opacity: 0; transform: translate(calc(var(--tx) * 1.7), calc(var(--ty) * 1.7 - 60px)) scale(1.35); } }

  /* ---- Poof: a flash ring, a dense core and billows that drift up and fade (transform + opacity only) ---- */
  .qz__poof { position: absolute; z-index: 6; left: 50%; top: 300px; width: 0; height: 0; pointer-events: none; }
  .qz__poof i { position: absolute; left: calc(var(--z) / -2); top: calc(var(--z) / -2); width: var(--z); height: var(--z); border-radius: 50%; opacity: 0;
    background: radial-gradient(circle at 42% 38%, #ffffff 0%, #f1ece2 38%, rgb(214 206 190 / 0.75) 58%, rgb(214 206 190 / 0) 72%); }
  .qz__flash { position: absolute; left: -40px; top: -40px; width: 80px; height: 80px; border-radius: 50%; border: 3px solid rgb(255 255 255 / 0.9); opacity: 0; }
  .qz__result.is-poof .qz__poof i { animation: qz-puff 1.25s cubic-bezier(.15,.7,.3,1) var(--d) both; }
  .qz__result.is-poof .qz__flash { animation: qz-flash 0.5s ease-out both; }
  @keyframes qz-puff {
    0% { opacity: 0; transform: rotate(var(--a)) translateX(0) scale(0.2); }
    12% { opacity: 1; }
    100% { opacity: 0; transform: rotate(var(--a)) translateX(var(--r)) translateY(-30px) scale(var(--s)); }
  }
  @keyframes qz-flash { 0% { opacity: 1; transform: scale(0.2); } 100% { opacity: 0; transform: scale(3.4); } }

  @media (max-width: 900px) {
    .qz { --floor: 56px; }
    /* Phones: a little stage. The Lord (left) and your Ninja (right) face each other on the boards,
