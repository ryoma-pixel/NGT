---
// "Let the scroll decide": the Lord asks three questions (where, day or night, what you're into) and your Ninja
// nods along ("Umu, umu"). The answer is not shown right away: a puff of smoke, a sealed mission scroll drops in,
// and when the guest unties it the big picture scroll below lands with a DON! and unrolls that tour's route.
// Coming-soon tours can be picked too; their scroll asks the guest to get in touch instead of booking.
import Icon from './Icon.astro';
import type { Tour } from '../lib/tours';
import type { IconName } from './icons';
interface Props { tours: Tour[] }
const { tours } = Astro.props;

const data = tours.map((t) => {
  const d = t.data;
  const times = d.startTimes ?? '';
  return {
    id: t.id, title: d.shortTitle, tagline: d.tagline ?? '', area: d.area,
    themes: d.themes, icons: d.features.map((f) => f.icon),
    night: d.themes.includes('Nightlife') || /night/i.test(times),
    day: !d.themes.includes('Nightlife') || /day/i.test(times),
    seasonal: d.themes.includes('FourSeasons'), soon: d.comingSoon || !d.bookingUrl,
  };
});

type Opt = { v: string; icon: IconName; label: string };
const questions: { key: string; step: string; q: string; opts: Opt[] }[] = [
  { key: 'area', step: 'Where', q: 'Where are you staying?', opts: [
    { v: 'Shinjuku', icon: 'pin', label: 'Shinjuku' },
    { v: 'Ueno', icon: 'pin', label: 'Ueno' },
    { v: 'Asakusa', icon: 'pin', label: 'Asakusa' },
    { v: 'any', icon: 'shuriken', label: 'Anywhere is fine' },
  ] },
  { key: 'time', step: 'When', q: 'Day or night?', opts: [
    { v: 'day', icon: 'sun', label: 'Daytime' },
    { v: 'night', icon: 'moon', label: 'After dark' },
  ] },
  { key: 'into', step: 'What', q: 'What are you into?', opts: [
    { v: 'culture', icon: 'torii', label: 'Shrines & old Tokyo' },
    { v: 'food', icon: 'sake', label: 'Local food & drinks' },
    { v: 'craft', icon: 'stamp', label: 'Crafts & souvenirs' },
    { v: 'ride', icon: 'scooter', label: 'Riding an e-scooter' },
  ] },
];

// Smoke: a dense core, a ring of billows and a few wisps that drift up. [angle, distance, scale, delay ms, size px]
const puffs: [number, number, number, number, number][] = [
  [0, 40, 2.2, 0, 150], [72, 46, 2.4, 20, 140], [144, 38, 2.1, 10, 160], [216, 44, 2.3, 30, 150], [288, 42, 2.0, 0, 140],
  [20, 130, 1.6, 60, 110], [65, 150, 1.4, 90, 100], [110, 140, 1.7, 70, 120], [160, 160, 1.3, 110, 90], [200, 135, 1.5, 80, 110],
  [245, 155, 1.4, 100, 100], [290, 145, 1.6, 60, 120], [335, 150, 1.3, 120, 90], [260, 210, 1.1, 180, 70], [300, 230, 1.0, 220, 60],
];
---
<section class="qz" id="quiz" data-quiz>
  <div class="wrap qz__in">
    <div class="qz__head">
      <p class="eyebrow">Can’t choose?</p>
      <h2>Let the scroll <span class="qz__o">decide.</span></h2>
      <p class="qz__lead">Three quick taps. Your Ninja seals the answer in a scroll.</p>
      <ol class="qz__trail" aria-label="Your answers">
        {questions.map((q, i) => (
          <li class:list={['qz__trail-i', { 'is-now': i === 0 }]} data-qz-trail={q.key}>
            <span class="qz__trail-k">{String(i + 1).padStart(2, '0')} · {q.step}</span>
            <span class="qz__trail-v" data-qz-trail-v>—</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="qz__box" data-qz-box>
      <div class="qz__ask" data-qz-ask>
        <button type="button" class="qz__back" data-qz-back hidden>← Back</button>
        <div class="qz__steps" data-qz-steps>
          {questions.map((q, i) => (
            <fieldset class="qz__step" data-qz-q={q.key} disabled={i > 0} aria-hidden={i > 0 ? 'true' : undefined}>
              <legend class="qz__q">
                <span class="qz__who qz__who--lord" aria-hidden="true">殿</span>
                <span class="qz__say"><small>The Lord asks · 0{i + 1}</small>{q.q}</span>
              </legend>
              <div class:list={['qz__opts', { 'qz__opts--two': q.opts.length === 2 }]}>
                {q.opts.map((o) => (
                  <button type="button" class="qz__opt" data-v={o.v} data-label={o.label}>
                    <Icon name={o.icon} size={30} />
                    <span>{o.label}</span>
                  </button>
                ))}
              </div>
            </fieldset>
          ))}
        </div>
        <p class="qz__nod" data-qz-nod hidden>
          <span class="qz__who qz__who--ninja" aria-hidden="true">忍</span>
          <span class="qz__say qz__say--ninja"><small>Your Ninja</small><span data-qz-nod-t></span></span>
        </p>
      </div>

      <div class="qz__result" data-qz-result hidden>
        <p class="qz__decree"><span class="qz__who qz__who--lord" aria-hidden="true">殿</span><span class="qz__say"><small>The Lord</small>It is decided. Untie the scroll, traveler.</span></p>
        <p class="visually-hidden" aria-live="polite" data-qz-status></p>
        <span class="qz__poof" aria-hidden="true">
          <b class="qz__flash"></b>
          {puffs.map(([a, r, s, d, z]) => <i style={`--a:${a}deg; --r:${r}px; --s:${s}; --d:${d}ms; --z:${z}px`}></i>)}
        </span>
        <span class="qz__ground" aria-hidden="true"></span>

        <div class="qz__scroll">
          <!-- the sealed scroll; the whole thing is the button -->
          <button type="button" class="qz__seal-scroll" data-qz-open aria-label="Untie the scroll to see your mission">
            <span class="qz__cap qz__cap--t" aria-hidden="true"></span>
            <span class="qz__silk" aria-hidden="true">
              <span class="qz__band qz__band--t"></span>
              <span class="qz__slip"><span class="qz__slip-jp">任務</span><span class="qz__slip-en">Your mission</span></span>
              <span class="qz__cord"><span class="qz__cord-l"></span><span class="qz__cord-r"></span></span>
              <svg class="qz__knot" viewBox="0 0 80 96" width="64" height="77">
                <g fill="none" stroke="#e7c465" stroke-width="5" stroke-linecap="round">
                  <path d="M40 22 C22 4 6 14 14 26 C20 34 34 28 40 22 Z" />
                  <path d="M40 22 C58 4 74 14 66 26 C60 34 46 28 40 22 Z" />
                  <path d="M37 26 C32 44 30 58 28 70" />
                  <path d="M43 26 C48 44 50 58 52 70" />
                </g>
                <circle cx="40" cy="23" r="7" fill="#f3d27a" stroke="#8a6a24" stroke-width="2" />
                <g fill="#d9b04e"><rect x="23" y="68" width="10" height="20" rx="3" /><rect x="47" y="68" width="10" height="20" rx="3" /></g>
                <g stroke="#8a6a24" stroke-width="1"><path d="M26 72v16M30 72v16M50 72v16M54 72v16" /></g>
              </svg>
              <span class="qz__band qz__band--b"></span>
            </span>
            <span class="qz__cap qz__cap--b" aria-hidden="true"></span>
          </button>


        </div>

        <p class="qz__tap" aria-hidden="true"><span class="qz__tap-dot"></span>Tap the scroll to untie it</p>
        <p class="qz__done" data-qz-done>Your mission: <strong data-qz-title></strong><a href="#mission" data-qz-down>Unrolled below <span aria-hidden="true">↓</span></a></p>
        <div class="qz__after">
          <button type="button" class="qz__again" data-qz-again>↺ Try again</button>
          <a class="qz__all" href="/tours">or see all tours →</a>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" data-qz-data set:html={JSON.stringify(data)} />
</section>

<script>
  type T = { id: string; title: string; tagline: string; area: string; themes: string[]; icons: string[]; night: boolean; day: boolean; seasonal: boolean; soon: boolean };
  // Each answer scores tours by their themes and by the icons on their "What you'll do" list
  const INTO: Record<string, { themes: Record<string, number>; icons: string[] }> = {
    culture: { themes: { History: 2, Entertainment: 2, Culture: 1 }, icons: ['torii', 'lantern'] },
    food: { themes: { Food: 3, Nightlife: 2 }, icons: ['sake', 'glass', 'dango', 'cup'] },
    craft: { themes: { JapaneseCustoms: 2, Shopping: 2 }, icons: ['stamp', 'knife', 'brush', 'bag'] },
    ride: { themes: { 'E-Scooter': 6 }, icons: ['scooter'] },
  };
  // What your Ninja says after each answer
  const NOD: Record<string, (label: string) => string> = {
    area: (l) => (l === 'Anywhere is fine' ? 'Umu, umu. Anywhere suits you. Noted.' : `Umu, umu. ${l}. Noted.`),
    time: (l) => `Umu. ${l} it is.`,
    into: (l) => `Umu, umu… ${l}. I know just the place, my lord.`,
  };
  const track = (event: string, params: Record<string, unknown> = {}) => {
    const w = window as unknown as { gtag?: (...a: unknown[]) => void; dataLayer?: unknown[] };
    if (typeof w.gtag === 'function') w.gtag('event', event, params);
    else (w.dataLayer = w.dataLayer || []).push({ event, ...params });
  };
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce() ? 0 : ms));

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((root) => {
    const tours: T[] = JSON.parse(root.querySelector('[data-qz-data]')!.textContent || '[]');
    const box = root.querySelector<HTMLElement>('[data-qz-box]')!;
    const ask = root.querySelector<HTMLElement>('[data-qz-ask]')!;
    const steps = root.querySelector<HTMLElement>('[data-qz-steps]')!;
    const qs = [...root.querySelectorAll<HTMLFieldSetElement>('[data-qz-q]')];
    const back = root.querySelector<HTMLButtonElement>('[data-qz-back]')!;
    const nod = root.querySelector<HTMLElement>('[data-qz-nod]')!;
    const nodText = root.querySelector<HTMLElement>('[data-qz-nod-t]')!;
    const result = root.querySelector<HTMLElement>('[data-qz-result]')!;
    const openBtn = root.querySelector<HTMLButtonElement>('[data-qz-open]')!;
    const status = root.querySelector<HTMLElement>('[data-qz-status]')!;
    const trail = [...root.querySelectorAll<HTMLElement>('[data-qz-trail]')];
    const answers: Record<string, string> = {};
    const labels: Record<string, string> = {};
    let current = 0, picked: T | undefined, busy = false;

    const paintTrail = () => trail.forEach((li, k) => {
      const key = li.dataset.qzTrail!;
      li.querySelector('[data-qz-trail-v]')!.textContent = labels[key] ?? '—';
      li.classList.toggle('is-done', key in labels);
      li.classList.toggle('is-now', k === current && result.hidden);
    });

    const go = (i: number) => {
      current = i;
      steps.style.transform = `translateX(${-100 * i}%)`;
      qs.forEach((q, k) => { q.disabled = k !== i; q.toggleAttribute('aria-hidden', k !== i); });
      back.hidden = i === 0;
      paintTrail();
      qs[i]?.querySelector<HTMLButtonElement>('button')?.focus({ preventScroll: true });
    };

    const pick = () => {
      const want = INTO[answers.into] ?? { themes: {}, icons: [] };
      let best: T | undefined; let bestScore = -Infinity;
      tours.forEach((t) => {
        let s = 0;
        if (answers.area !== 'any') s += t.area === answers.area ? 6 : -6;
        s += (answers.time === 'night' ? t.night : t.day) ? 4 : -4;
        t.themes.forEach((th) => { s += want.themes[th] ?? 0; });
        s += t.icons.filter((ic) => want.icons.includes(ic)).length * 2;
        if (answers.into !== 'ride' && t.themes.includes('E-Scooter')) s -= 3;
        // Seasonal tours (the spring cherry blossom walk) only win in March–April
        if (t.seasonal) s -= [2, 3].includes(new Date().getMonth()) ? 1 : 8;
        // a tour that is not bookable yet only wins a clear match
        if (t.soon) s -= 1;
        if (s > bestScore) { bestScore = s; best = t; }
      });
      return best!;
    };

    // Your Ninja nods: "Umu, umu."
    const sayNod = async (key: string) => {
      nodText.textContent = NOD[key]?.(labels[key]) ?? 'Umu.';
      nod.hidden = false;
      nod.classList.remove('is-on'); void nod.offsetWidth; nod.classList.add('is-on');
      await wait(1150);
    };

    // 1) the questions fade away  2) poof of smoke  3) the sealed scroll drops in and the Lord speaks
    const reveal = async () => {
      picked = pick();
      ask.classList.add('is-leaving');
      await wait(380);
      box.classList.add('is-done');
      nod.hidden = true;
      result.hidden = false;
      result.classList.remove('is-open', 'is-poof', 'is-untie');
      root.querySelector('[data-qz-title]')!.textContent = picked.title;
      void result.offsetWidth;
      result.classList.add('is-poof');
      paintTrail();
      root.classList.add('is-sealed');
      status.textContent = 'The Lord has sealed your mission in a scroll. Untie it to see it.';
      const r = result.getBoundingClientRect();
      if (r.top < 60 || r.top + 480 > innerHeight) result.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth', block: 'center' });
      track('quiz_complete', { tour: picked.id, area: answers.area, time: answers.time, into: answers.into });
      await wait(900);
      openBtn.focus({ preventScroll: true });
      busy = false;
    };

    // Untie: the knot and cord come off, the scroll drops away, and the big scroll below lands with a DON!
    openBtn.addEventListener('click', async () => {
      if (!picked || result.classList.contains('is-open')) return;
      result.classList.add('is-untie');
      await wait(450);
      result.classList.add('is-open');
      root.classList.remove('is-sealed');
      status.textContent = `Your mission: ${picked.title}. ${picked.tagline}. It unrolls below.`;
      document.dispatchEvent(new CustomEvent('ngt:mission', { detail: { id: picked.id, why: `For ${Object.values(labels).join(' · ')}` } }));
      await wait(250);
      document.dispatchEvent(new CustomEvent('ngt:mission-open'));
      track('quiz_open', { tour: picked.id });
    });

    root.querySelector<HTMLAnchorElement>('[data-qz-down]')?.addEventListener('click', (e) => {
      const target = document.getElementById('mission-scroll');
      if (!target || target.hidden) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth', block: 'start' });
    });

    qs.forEach((q, i) => q.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.qz__opt');
      if (!b || busy) return;
      busy = true;
      const key = q.dataset.qzQ!;
      answers[key] = b.dataset.v!;
      labels[key] = b.dataset.label!;
      q.querySelectorAll('.qz__opt').forEach((o) => o.classList.toggle('is-picked', o === b));
      paintTrail();
      await sayNod(key);
      if (i < qs.length - 1) { nod.hidden = true; go(i + 1); busy = false; }
      else reveal();
    }));

    back.addEventListener('click', () => { if (current > 0 && !busy) { nod.hidden = true; go(current - 1); } });

    root.querySelector('[data-qz-again]')!.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('ngt:mission-reset'));
      result.classList.remove('is-open', 'is-poof', 'is-untie');
      result.hidden = true;
      root.classList.remove('is-sealed');
      box.classList.remove('is-done');
      ask.classList.remove('is-leaving');
      nod.hidden = true;
      Object.keys(answers).forEach((k) => { delete answers[k]; delete labels[k]; });
      qs.forEach((q) => q.querySelectorAll('.qz__opt').forEach((o) => o.classList.remove('is-picked')));
      status.textContent = '';
      busy = false;
      go(0);
      root.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth', block: 'start' });
    });
  });
</script>

<style>
  /* Needs JS to work, so it only appears when scripts run */
  .qz { display: none; }
  :global(.js) .qz { display: block; }
  .qz { --gold: #e7c465; background: #efe4cc var(--washi); color: var(--ai); padding: 84px 0 76px; overflow: clip; border-top: 1px solid rgb(31 45 82 / 0.12); }
  .qz .eyebrow { color: var(--ai); }
  .qz__in { display: grid; grid-template-columns: 1fr 1.65fr; gap: 32px 56px; align-items: start; }
  .qz__head h2 { font-size: clamp(2.6rem, 6vw, 4.8rem); line-height: 0.95; margin: 0 0 14px; }
  .qz__o { color: transparent; -webkit-text-stroke: 2px var(--ai); }
  .qz__lead { margin: 0 0 22px; max-width: 28ch; color: #4a4336; }

  /* The trail of answers: fills in as you go */
  .qz__trail { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; max-width: 320px; }
  .qz__trail-i { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; padding: 9px 12px; border: 1.5px dashed rgb(31 45 82 / 0.35); border-radius: 8px; transition: background 0.3s, border-color 0.3s, color 0.3s; }
  .qz__trail-k { font-family: var(--mono); font-weight: 700; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .qz__trail-v { font-family: var(--display); font-size: 1.05rem; text-transform: uppercase; text-align: right; }
  .qz__trail-i.is-now { border-style: solid; border-color: var(--ai); background: #fff; }
  .qz__trail-i.is-done { border-style: solid; border-color: var(--ai); background: var(--ai); color: var(--cream); }

  /* Who is speaking: the Lord (殿) and your Ninja (忍), as round crests (illustrations can replace them later) */
  .qz__who { flex: none; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; font-family: var(--mincho); font-weight: 800; font-size: 1.7rem; line-height: 1; }
  .qz__who--lord { background: var(--ai) var(--seigaiha); color: var(--cream); box-shadow: 0 0 0 3px var(--gold), 0 6px 14px rgb(31 45 82 / 0.3); }
  .qz__who--ninja { background: #14151f; color: var(--cream); box-shadow: 0 0 0 3px var(--cream), 0 0 0 5px #14151f, 0 6px 14px rgb(0 0 0 / 0.3); }
  .qz__say { position: relative; display: block; background: #fff; border: 2px solid var(--ai); border-radius: 14px; padding: 10px 16px 12px; box-shadow: 0 4px 0 var(--ai); }
  .qz__say::before { content: ''; position: absolute; left: -10px; top: 20px; width: 16px; height: 16px; background: #fff; border-left: 2px solid var(--ai); border-bottom: 2px solid var(--ai); transform: rotate(45deg); }
  .qz__say small { display: block; font-family: var(--mono); font-weight: 700; font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(31 45 82 / 0.65); margin-bottom: 4px; }

  /* Questions */
  .qz__box { position: relative; min-width: 0; }
  .qz__ask { position: relative; overflow: clip; padding: 4px 0 12px; min-height: 330px; transition: opacity 0.35s, transform 0.35s cubic-bezier(.7,0,.2,1); }
  .qz__ask.is-leaving { opacity: 0; transform: translateY(-16px) scale(0.98); }
  .qz__box.is-done .qz__ask { display: none; }
  .qz__steps { display: flex; transition: transform 0.55s cubic-bezier(.7,0,.2,1); }
  .qz__step { flex: none; width: 100%; border: 0; margin: 0; padding: 0; min-width: 0; transition: opacity 0.4s; }
  .qz__step[disabled] { opacity: 0; }
  .qz__back { position: absolute; top: 0; right: 0; z-index: 2; background: none; border: 0; padding: 6px 2px; color: var(--ai); font-family: var(--mono); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; border-bottom: 2px solid transparent; }
  .qz__back:hover, .qz__back:focus-visible { border-bottom-color: var(--ai); outline: none; }
  .qz__q { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 18px; padding: 0 84px 0 0; }
  .qz__q .qz__say { font-family: var(--display); text-transform: uppercase; font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.05; }
  .qz__opts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .qz__opts--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* Answer cards: white on washi, navy frame and a filled icon disc, so they read as buttons */
  .qz__opt { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 18px; min-height: 124px; background: #fff; color: var(--ai); border: 2px solid var(--ai); border-radius: 10px; box-shadow: 0 5px 0 var(--ai); cursor: pointer; font-family: var(--display); font-size: 1.35rem; text-transform: uppercase; text-align: left; line-height: 1; transition: background 0.2s, color 0.2s, transform 0.15s, box-shadow 0.15s; }
  .qz__opt :global(svg) { width: 44px; height: 44px; padding: 8px; border-radius: 50%; background: var(--ai); color: var(--cream); flex: none; transition: background 0.2s, color 0.2s, transform 0.3s cubic-bezier(.3,1.6,.5,1); }
  .qz__opt:hover, .qz__opt:focus-visible { background: var(--ai); color: var(--cream); transform: translateY(-2px); box-shadow: 0 7px 0 #0f1730; outline: none; }
  .qz__opt:hover :global(svg), .qz__opt:focus-visible :global(svg) { background: var(--cream); color: var(--ai); transform: rotate(-10deg) scale(1.08); }
  .qz__opt:active { transform: translateY(4px); box-shadow: 0 1px 0 var(--ai); }
  .qz__opt.is-picked { background: var(--ai); color: var(--cream); animation: qz-picked 0.3s ease; }
  .qz__opt.is-picked :global(svg) { background: var(--gold); color: var(--ai); }
  .qz__opt.is-picked::after { content: '✓'; position: absolute; top: 12px; right: 14px; font-family: var(--mono); font-size: 1rem; }
  @keyframes qz-picked { 50% { transform: scale(0.96); } }

  /* Your Ninja nods: the badge bows twice, the bubble pops in from the right */
  .qz__nod { display: flex; flex-direction: row-reverse; align-items: flex-start; gap: 14px; margin: 18px 0 0; }
  .qz__nod[hidden] { display: none; }
  .qz__say--ninja { background: #14151f; color: var(--cream); border-color: #14151f; box-shadow: 0 4px 0 #000; font-weight: 700; font-size: 1.05rem; }
  .qz__say--ninja::before { left: auto; right: -10px; background: #14151f; border: 0; }
  .qz__say--ninja small { color: rgb(247 240 227 / 0.7); }
  .qz__nod.is-on .qz__say--ninja { animation: qz-say 0.35s cubic-bezier(.3,1.5,.5,1) both; }
  .qz__nod.is-on .qz__who--ninja { animation: qz-nodnod 0.9s ease-in-out 0.1s both; }
