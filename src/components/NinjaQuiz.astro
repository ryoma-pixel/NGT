  .qz__scroll { position: relative; width: 100%; height: 440px; }

  .qz__seal-scroll { position: absolute; z-index: 4; left: 50%; top: 20px; height: 400px; width: 150px; margin-left: -75px; padding: 0; border: 0; background: none; cursor: pointer; display: flex; flex-direction: column; align-items: center; color: var(--ai); -webkit-tap-highlight-color: transparent; }
  .qz__cap { flex: none; width: 58%; height: 16px; border-radius: 8px; background: linear-gradient(90deg, #3b2412, #b07a42 45%, #d9a868 55%, #3b2412); box-shadow: 0 2px 4px rgb(0 0 0 / 0.3); position: relative; z-index: 1; }
  .qz__cap::after { content: ''; position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #fff8e6, #d8ccb0 60%, #a89a7a); box-shadow: 0 2px 4px rgb(0 0 0 / 0.35); }
