    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0) 22%, rgb(255 255 255 / 0.12) 46%, rgb(255 255 255 / 0) 60%, rgb(0 0 0 / 0.5)),
      var(--ai) var(--seigaiha);
    box-shadow: 0 26px 40px -12px rgb(31 45 82 / 0.55); }
  .qz__band { position: absolute; left: 0; right: 0; height: 12px; background: repeating-linear-gradient(90deg, #c9a14a 0 6px, #e7c465 6px 12px); opacity: 0.9; }
  .qz__band--t { top: 22px; }
  .qz__band--b { bottom: 22px; }
  .qz__slip { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 10px; background: #fbf6ea; color: var(--ai); padding: 16px 10px 12px; width: 56%; margin-top: -40px; box-shadow: 0 4px 10px rgb(0 0 0 / 0.35); border: 1px solid #d9cdb3; }
  .qz__slip-jp { writing-mode: vertical-rl; font-family: var(--mincho); font-weight: 800; font-size: 2rem; line-height: 1; letter-spacing: 0.15em; }
  .qz__slip-en { font-family: var(--mono); font-weight: 700; font-size: 0.56rem; letter-spacing: 0.12em; text-transform: uppercase; text-align: center; line-height: 1.3; }
  .qz__cord { position: absolute; left: -2px; right: -2px; top: 62%; height: 9px; z-index: 2; }
  .qz__cord-l, .qz__cord-r { position: absolute; top: 0; bottom: 0; width: 50%; background: repeating-linear-gradient(135deg, #8a6a24 0 3px, #e7c465 3px 7px); box-shadow: 0 2px 4px rgb(0 0 0 / 0.4); transition: transform 0.4s cubic-bezier(.7,0,.2,1), opacity 0.4s; }
  .qz__cord-l { left: 0; border-radius: 4px 0 0 4px; }
  .qz__cord-r { right: 0; border-radius: 0 4px 4px 0; }
  .qz__knot { position: absolute; z-index: 3; left: 50%; top: calc(62% - 20px); margin-left: -32px; transform-origin: 50% 25%; filter: drop-shadow(0 3px 3px rgb(0 0 0 / 0.4)); transition: transform 0.4s cubic-bezier(.7,0,.2,1), opacity 0.3s; }
  .qz__seal-scroll:hover .qz__silk, .qz__seal-scroll:focus-visible .qz__silk { outline: 3px solid var(--gold); outline-offset: 5px; }
  .qz__seal-scroll:focus { outline: none; }

  .qz__ground { position: absolute; z-index: 0; left: 50%; top: 470px; width: 240px; height: 28px; margin-left: -120px; border-radius: 50%; background: radial-gradient(ellipse, rgb(31 45 82 / 0.28), transparent 70%); opacity: 0; transform: scale(0.4); transition: opacity 0.5s, transform 0.5s; }
  .qz.is-sealed .qz__ground { opacity: 1; transform: none; }
  .qz__decree ~ .qz__ground { top: calc(470px + var(--decree-h, 70px)); }

  .qz__tap { position: relative; z-index: 3; display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 7px 14px; border-radius: 999px; background: rgb(255 248 232 / 0.88); font-family: var(--mono); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0; }
  .qz__tap-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--ai); animation: qz-ping 1.5s ease-out infinite; }
  @keyframes qz-ping { 0% { box-shadow: 0 0 0 0 rgb(31 45 82 / 0.5); } 100% { box-shadow: 0 0 0 12px rgb(31 45 82 / 0); } }
  .qz.is-sealed .qz__tap { opacity: 1; transition: opacity 0.4s 1s; }

  /* 1) arrive: drops out of the smoke with a bounce, then wiggles now and then */
  .qz__result.is-poof .qz__seal-scroll { animation: qz-drop 0.75s cubic-bezier(.3,1.45,.5,1) 0.2s both, qz-wiggle 3.2s ease-in-out 2s infinite; }
  @keyframes qz-drop { 0% { opacity: 0; transform: translateY(-60px) scale(0.5) rotate(-14deg); } 60% { opacity: 1; } 100% { opacity: 1; transform: none; } }
  @keyframes qz-wiggle { 0%, 84%, 100% { transform: none; } 88% { transform: rotate(-3deg) translateY(-3px); } 92% { transform: rotate(3deg) translateY(-3px); } 96% { transform: rotate(-1.5deg); } }
  /* 2) untie: the knot falls, the cord slides off both sides */
  .qz__result.is-untie .qz__knot { transform: translateY(40px) rotate(24deg) scale(0.6); opacity: 0; }
  .qz__result.is-untie .qz__cord-l { transform: translateX(-60px); opacity: 0; }
  .qz__result.is-untie .qz__cord-r { transform: translateX(60px); opacity: 0; }
  .qz__result.is-untie .qz__seal-scroll { animation: none; }
  /* 3) untied: the cord and knot fall away, then the smoke bomb takes over (the quiz turns into the mission scroll) */
  .qz[hidden] { display: none !important; }
  :global(.qz-bomb) { position: fixed; inset: 0; z-index: 90; pointer-events: none; overflow: hidden; }
  :global(.qz-bomb::before) { content: ''; position: absolute; inset: 0; background: #efe7d6; opacity: 0; animation: qz-bomb-fill 0.3s ease 0.32s forwards; }
  :global(.qz-bomb i) { position: absolute; left: calc(var(--x) - var(--z) / 2); top: calc(var(--y) - var(--z) / 2); width: var(--z); height: var(--z); border-radius: 50%; opacity: 0;
    background: radial-gradient(circle at 40% 38%, #fffdf7, #f3ecdc 42%, rgb(226 216 196 / 0.92) 60%, rgb(226 216 196 / 0) 71%);
    animation: qz-bomb-in 0.56s cubic-bezier(.15,.8,.3,1) var(--dl) forwards; }
  :global(.qz-bomb.is-clear::before) { animation: qz-bomb-unfill 0.45s ease forwards; }
