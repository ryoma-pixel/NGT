---
// "Let the scroll decide": the Lord asks up to three questions (where, day or night, what you're into) and your Ninja
// nods along ("Umu, umu"). Questions that cannot change the answer are skipped: Ueno has one walk, so it ends there;
// day-or-night is only asked when the area has both; only interests that match a walk are offered. The answer is not shown right away: a puff of smoke, a sealed mission scroll drops in,
// and when the guest unties it a smoke bomb fills the screen; when it clears, the quiz has turned into that tour's
// picture scroll (the Emaki with `mission`), which lands with a DON! right there and unrolls the route. No page jump.
// Coming-soon tours can be picked too; their scroll asks the guest to get in touch instead of booking.
import Icon from './Icon.astro';
import type { Tour } from '../lib/tours';
import type { IconName } from './icons';
interface Props { tours: Tour[] }
const { tours } = Astro.props;

const data = tours.map((t) => {
  const d = t.data;
  const times = d.startTimes ?? '';
  // day or night from the first start time (5 PM or later = after dark); "Day course / Night course" counts as both
  const m = times.match(/(\d{1,2}):\d{2}\s*(AM|PM)/i);
  const hour = m ? (Number(m[1]) % 12) + (/pm/i.test(m[2]) ? 12 : 0) : 12;
  return {
    id: t.id, title: d.shortTitle, tagline: d.tagline ?? '', area: d.area,
    themes: d.themes, icons: d.features.map((f) => f.icon),
    night: /\bnight\b/i.test(times) || hour >= 17,
    day: /\bday\b/i.test(times) || hour < 17,
    seasonal: d.themes.includes('FourSeasons'), soon: d.comingSoon || !d.bookingUrl,
  };
});

type Opt = { v: string; icon: IconName; label: string };
const questions: { key: string; step: string; q: string; opts: Opt[] }[] = [
  { key: 'area', step: 'Where', q: 'Where are you staying?', opts: [
    { v: 'Shinjuku', icon: 'pin', label: 'Shinjuku' },
    { v: 'Ueno', icon: 'pin', label: 'Ueno' },
    { v: 'Asakusa', icon: 'pin', label: 'Asakusa' },
    { v: 'any', icon: 'shuriken', label: 'Anywhere is fine' },
  ] },
  { key: 'time', step: 'When', q: 'Day or night?', opts: [
    { v: 'day', icon: 'sun', label: 'Daytime' },
    { v: 'night', icon: 'moon', label: 'After dark' },
  ] },
  { key: 'into', step: 'What', q: 'What are you into?', opts: [
    { v: 'culture', icon: 'torii', label: 'Shrines & old Tokyo' },
    { v: 'food', icon: 'sake', label: 'Local food & drinks' },
    { v: 'craft', icon: 'stamp', label: 'Crafts & souvenirs' },
    { v: 'ride', icon: 'scooter', label: 'Riding an e-scooter' },
  ] },
];

// Smoke: a dense core, a ring of billows and a few wisps that drift up. [angle, distance, scale, delay ms, size px]
const puffs: [number, number, number, number, number][] = [
  [0, 40, 2.2, 0, 150], [72, 46, 2.4, 20, 140], [144, 38, 2.1, 10, 160], [216, 44, 2.3, 30, 150], [288, 42, 2.0, 0, 140],
  [20, 130, 1.6, 60, 110], [65, 150, 1.4, 90, 100], [110, 140, 1.7, 70, 120], [160, 160, 1.3, 110, 90], [200, 135, 1.5, 80, 110],
  [245, 155, 1.4, 100, 100], [290, 145, 1.6, 60, 120], [335, 150, 1.3, 120, 90], [260, 210, 1.1, 180, 70], [300, 230, 1.0, 220, 60],
];
---
<section class="qz" id="quiz" data-quiz>
  <div class="wrap qz__in">
    <div class="qz__head">
      <p class="eyebrow">Can’t choose?</p>
      <h2>Let the scroll <span class="qz__o">decide.</span></h2>
    </div>

    <div class="qz__box" data-qz-box>
      <div class="qz__ask" data-qz-ask>
        <button type="button" class="qz__back" data-qz-back hidden>← Back</button>
        <div class="qz__steps" data-qz-steps>
          {questions.map((q, i) => (
            <fieldset class="qz__step" data-qz-q={q.key} disabled={i > 0} aria-hidden={i > 0 ? 'true' : undefined}>
              <legend class="qz__q">
                <span class="qz__say"><small><b>殿</b>The Lord asks</small><span class="visually-hidden">{q.q}</span><span class="qz__line" aria-hidden="true" data-type>{q.q}</span></span>
              </legend>
              <div class:list={['qz__opts', { 'qz__opts--two': q.opts.length === 2 }]}>
                {q.opts.map((o) => (
                  <button type="button" class="qz__opt" data-v={o.v} data-label={o.label}>
                    <Icon name={o.icon} size={30} />
                    <span>{o.label}</span>
                  </button>
                ))}
              </div>
            </fieldset>
          ))}
        </div>
        <p class="qz__nod" data-qz-nod hidden>
          <span class="qz__say qz__say--ninja"><small><b>忍</b>Your Ninja</small><span class="qz__line" data-qz-nod-t></span></span>
        </p>
      </div>

      <div class="qz__result" data-qz-result hidden>
        <p class="qz__decree"><span class="qz__say"><small><b>殿</b>The Lord</small><span class="visually-hidden">It is decided. Untie the scroll, traveler.</span><span class="qz__line" aria-hidden="true" data-type>It is decided. Untie the scroll, traveler.</span></span></p>
        <p class="visually-hidden" aria-live="polite" data-qz-status></p>
        <span class="qz__poof" aria-hidden="true">
          <b class="qz__flash"></b>
          {puffs.map(([a, r, s, d, z]) => <i style={`--a:${a}deg; --r:${r}px; --s:${s}; --d:${d}ms; --z:${z}px`}></i>)}
        </span>
        <span class="qz__ground" aria-hidden="true"></span>

        <div class="qz__scroll">
          <!-- the sealed scroll; the whole thing is the button -->
          <button type="button" class="qz__seal-scroll" data-qz-open aria-label="Untie the scroll to see your mission">
            <span class="qz__cap qz__cap--t" aria-hidden="true"></span>
            <span class="qz__silk" aria-hidden="true">
              <span class="qz__band qz__band--t"></span>
              <span class="qz__slip"><span class="qz__slip-jp">任務</span><span class="qz__slip-en">Your mission</span></span>
              <span class="qz__cord"><span class="qz__cord-l"></span><span class="qz__cord-r"></span></span>
              <svg class="qz__knot" viewBox="0 0 80 96" width="64" height="77">
                <g fill="none" stroke="#e7c465" stroke-width="5" stroke-linecap="round">
                  <path d="M40 22 C22 4 6 14 14 26 C20 34 34 28 40 22 Z" />
                  <path d="M40 22 C58 4 74 14 66 26 C60 34 46 28 40 22 Z" />
                  <path d="M37 26 C32 44 30 58 28 70" />
                  <path d="M43 26 C48 44 50 58 52 70" />
                </g>
                <circle cx="40" cy="23" r="7" fill="#f3d27a" stroke="#8a6a24" stroke-width="2" />
                <g fill="#d9b04e"><rect x="23" y="68" width="10" height="20" rx="3" /><rect x="47" y="68" width="10" height="20" rx="3" /></g>
                <g stroke="#8a6a24" stroke-width="1"><path d="M26 72v16M30 72v16M50 72v16M54 72v16" /></g>
              </svg>
              <span class="qz__band qz__band--b"></span>
            </span>
            <span class="qz__cap qz__cap--b" aria-hidden="true"></span>
          </button>


        </div>

        <p class="qz__tap" aria-hidden="true"><span class="qz__tap-dot"></span>Tap the scroll to untie it</p>
      </div>
    </div>

    <!-- The stage: the Lord (left) asks, your Ninja (right) nods. Ukiyo-e illustrations, for illustration only. -->
    <span class="qz__floor" aria-hidden="true"></span>
    <figure class="qz__fig qz__fig--lord" data-qz-lord aria-hidden="true">
      <span class="qz__fig-pic"><img src="/images/characters/lord-480.webp" srcset="/images/characters/lord-480.webp 480w, /images/characters/lord-960.webp 960w" sizes="(max-width: 900px) 46vw, 330px" width="480" height="600" alt="" loading="lazy" decoding="async" /></span>
      <b class="qz__fig-name">殿</b>
    </figure>
    <figure class="qz__fig qz__fig--ninja" data-qz-ninja aria-hidden="true">
      <span class="qz__fig-smoke"><i></i><i></i><i></i><i></i></span>
      <span class="qz__fig-pic"><img src="/images/characters/ninja-480.webp" srcset="/images/characters/ninja-480.webp 480w, /images/characters/ninja-960.webp 960w" sizes="(max-width: 900px) 40vw, 290px" width="480" height="600" alt="" loading="lazy" decoding="async" /></span>
      <b class="qz__fig-name">忍</b>
    </figure>
  </div>
  <script type="application/json" data-qz-data set:html={JSON.stringify(data)} />
</section>

<script>
  type T = { id: string; title: string; tagline: string; area: string; themes: string[]; icons: string[]; night: boolean; day: boolean; seasonal: boolean; soon: boolean };
  // Each answer scores tours by their themes and by the icons on their "What you'll do" list
  const INTO: Record<string, { themes: Record<string, number>; icons: string[] }> = {
    culture: { themes: { History: 2, Entertainment: 2, Culture: 1 }, icons: ['torii', 'lantern'] },
    food: { themes: { Food: 3, Nightlife: 2 }, icons: ['sake', 'glass', 'dango', 'cup'] },
    craft: { themes: { JapaneseCustoms: 2, Shopping: 2 }, icons: ['stamp', 'knife', 'brush', 'bag'] },
    ride: { themes: { 'E-Scooter': 6 }, icons: ['scooter'] },
  };
  // What your Ninja says after each answer
  const NOD: Record<string, (label: string) => string> = {
    area: (l) => (l === 'Anywhere is fine' ? 'Umu, umu. Anywhere suits you. Noted.' : `Umu, umu. ${l}. Noted.`),
    time: (l) => `Umu. ${l} it is.`,
    into: (l) => `Umu, umu… ${l}. I know just the place, my lord.`,
  };
  const track = (event: string, params: Record<string, unknown> = {}) => {
    const w = window as unknown as { gtag?: (...a: unknown[]) => void; dataLayer?: unknown[] };
    if (typeof w.gtag === 'function') w.gtag('event', event, params);
    else (w.dataLayer = w.dataLayer || []).push({ event, ...params });
  };
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce() ? 0 : ms));

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((root) => {
    const tours: T[] = JSON.parse(root.querySelector('[data-qz-data]')!.textContent || '[]');
    const box = root.querySelector<HTMLElement>('[data-qz-box]')!;
    const ask = root.querySelector<HTMLElement>('[data-qz-ask]')!;
    const steps = root.querySelector<HTMLElement>('[data-qz-steps]')!;
    const qs = [...root.querySelectorAll<HTMLFieldSetElement>('[data-qz-q]')];
    const back = root.querySelector<HTMLButtonElement>('[data-qz-back]')!;
    const nod = root.querySelector<HTMLElement>('[data-qz-nod]')!;
    const nodText = root.querySelector<HTMLElement>('[data-qz-nod-t]')!;
    const result = root.querySelector<HTMLElement>('[data-qz-result]')!;
    const openBtn = root.querySelector<HTMLButtonElement>('[data-qz-open]')!;
    const status = root.querySelector<HTMLElement>('[data-qz-status]')!;
    const lord = root.querySelector<HTMLElement>('[data-qz-lord]')!;
    const ninja = root.querySelector<HTMLElement>('[data-qz-ninja]')!;
    // who is talking: the other one steps back (phones show both, face to face)
    const speak = (who: 'lord' | 'ninja') => { root.dataset.speaker = who; };
    // type a line out letter by letter, like a dialogue window (the full text is also in the page for screen readers)
    const typing = new WeakMap<HTMLElement, number>();
    const type = (el: HTMLElement | null | undefined, text?: string) => {
      if (!el) return 0;
      const full = text ?? el.dataset.full ?? el.textContent ?? '';
      el.dataset.full = full;
      clearInterval(typing.get(el));
      if (reduce()) { el.textContent = full; return 0; }
      let n = 0;
      el.textContent = '';
      typing.set(el, window.setInterval(() => { n += 1; el.textContent = full.slice(0, n); if (n >= full.length) clearInterval(typing.get(el)); }, 18));
      return full.length * 18;
    };
    // restart a one-shot animation class
    const cue = (el: HTMLElement, cls: string) => { el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); };
    const answers: Record<string, string> = {};
    const labels: Record<string, string> = {};
    let current = 0, picked: T | null = null, busy = false;
    const hist: number[] = [];

    // Which walks still fit the answers so far (the spring-only walk counts only in March–April)
    const inSeason = [2, 3].includes(new Date().getMonth());
    const fits = (t: T, a: Record<string, string>) =>
      (!a.area || a.area === 'any' || t.area === a.area) && (!a.time || (a.time === 'night' ? t.night : t.day));
    const cands = (a: Record<string, string> = answers) => {
      const all = tours.filter((t) => fits(t, a));
      const now = all.filter((t) => !t.seasonal || inSeason);
      return now.length ? now : all;
    };
    const intoScore = (t: T, v: string) => {
      const want = INTO[v];
      if (!want) return 0;
      return t.themes.reduce((s, th) => s + (want.themes[th] ?? 0), 0) + t.icons.filter((ic) => want.icons.includes(ic)).length * 2;
    };
    const viable = (key: string, v: string) =>
      key === 'into' ? cands().some((t) => intoScore(t, v) > 0) : cands({ ...answers, [key]: v }).length > 0;
    // Find the next question worth asking after question i (hiding answers that fit no walk); -1 = the scroll is decided
    const advance = (i: number): number => {
      for (let k = i + 1; k < qs.length; k++) {
        if (cands().length <= 1) return -1;
        const key = qs[k].dataset.qzQ!;
        const opts = [...qs[k].querySelectorAll<HTMLButtonElement>('.qz__opt')];
        const ok = opts.filter((o) => viable(key, o.dataset.v!));
        opts.forEach((o) => { o.hidden = !ok.includes(o); });
        if (ok.length >= 2) return k;
        if (ok.length === 1 && key !== 'into') answers[key] = ok[0].dataset.v!; // only one way to go: take it quietly
      }
      return -1;
    };
    const clearFrom = (j: number) => qs.slice(j).forEach((q) => {
      delete answers[q.dataset.qzQ!]; delete labels[q.dataset.qzQ!];
      q.querySelectorAll('.qz__opt').forEach((o) => o.classList.remove('is-picked'));
    });

    const go = (i: number) => {
      current = i;
      steps.style.transform = `translateX(${-100 * i}%)`;
      qs.forEach((q, k) => { q.disabled = k !== i; q.toggleAttribute('aria-hidden', k !== i); });
      back.hidden = hist.length === 0;
      cue(lord, 'is-speak');
      speak('lord');
      type(qs[i]?.querySelector<HTMLElement>('[data-type]'));
      qs[i]?.querySelector<HTMLButtonElement>('button')?.focus({ preventScroll: true });
    };

    const pick = () => {
      const list = cands();
      let best = list[0]; let bestScore = -Infinity;
      list.forEach((t) => {
        let sc = answers.into ? intoScore(t, answers.into) : 0;
        if (answers.into !== 'ride' && t.themes.includes('E-Scooter')) sc -= 3;
        if (t.soon) sc -= 1; // a walk that is not bookable yet only wins a clear match
        if (sc > bestScore) { bestScore = sc; best = t; }
      });
      return best ?? tours[0];
    };

    // Your Ninja nods: "Umu, umu."
    const sayNod = async (key: string, decided = false) => {
      nod.hidden = false;
      speak('ninja');
      const l = labels[key];
      const line = decided && key !== 'into'
        ? (key === 'area' ? `Umu. In ${l}, one mission stands above the rest.` : `Umu. ${l}… then there is one mission for you.`)
        : NOD[key]?.(l) ?? 'Umu.';
      const t = type(nodText, line);
      nod.classList.remove('is-on'); void nod.offsetWidth; nod.classList.add('is-on');
      ninja.classList.add('is-in');
      cue(ninja, 'is-nod');
      await wait(Math.max(1250, t + 500));
      ninja.classList.remove('is-nod');
    };

    // 1) the questions fade away  2) poof of smoke  3) the sealed scroll drops in and the Lord speaks
    const reveal = async () => {
      picked = pick();
      ask.classList.add('is-leaving');
      await wait(380);
      box.classList.add('is-done');
      nod.hidden = true;
      result.hidden = false;
      result.classList.remove('is-poof', 'is-untie');
      void result.offsetWidth;
      result.classList.add('is-poof');
      root.classList.add('is-sealed');
      cue(lord, 'is-speak');
      speak('lord');
      const decree = result.querySelector<HTMLElement>('.qz__decree [data-type]');
      if (decree && !reduce()) { const line = decree.dataset.full ?? decree.textContent ?? ''; decree.dataset.full = line; decree.textContent = ''; setTimeout(() => type(decree, line), 900); }
      status.textContent = 'The Lord has sealed your mission in a scroll. Untie it to see it.';
      const r = result.getBoundingClientRect();
      if (r.top < 60 || r.top + 480 > innerHeight) result.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth', block: 'center' });
      track('quiz_complete', { tour: picked.id, area: answers.area, time: answers.time, into: answers.into });
      await wait(900);
      openBtn.focus({ preventScroll: true });
      busy = false;
    };

    // Smoke bomb: cream smoke bursts out of the scroll and fills the screen; resolves once the screen is covered
    const bomb = (x: number, y: number) => new Promise<HTMLElement>((done) => {
      const el = document.createElement('div');
      el.className = 'qz-bomb';
      el.setAttribute('aria-hidden', 'true');
      el.style.setProperty('--x', `${x}px`);
      el.style.setProperty('--y', `${y}px`);
      const R = Math.hypot(innerWidth, innerHeight);
      for (let i = 0; i < 18; i++) {
        const a = (i / 18) * Math.PI * 2 + (i % 2) * 0.2;
        const d = R * (0.12 + (i % 3) * 0.16), z = R * (0.42 + (i % 4) * 0.1);
        const b = document.createElement('i');
        b.style.cssText = `--tx:${Math.round(Math.cos(a) * d)}px;--ty:${Math.round(Math.sin(a) * d)}px;--z:${Math.round(z)}px;--dl:${(i % 4) * 40}ms`;
        el.append(b);
      }
      document.body.append(el);
      setTimeout(() => done(el), 640);
    });

    // Untie: the knot and cord come off, a smoke bomb, and the quiz becomes the mission scroll in the same place
    openBtn.addEventListener('click', async () => {
      if (!picked || result.classList.contains('is-untie')) return;
      result.classList.add('is-untie');
      await wait(420);
      const r = openBtn.getBoundingClientRect();
      const smoke = reduce() ? null : await bomb(r.left + r.width / 2, r.top + r.height / 2);
      document.dispatchEvent(new CustomEvent('ngt:mission', { detail: { id: picked.id, why: `For ${Object.values(labels).join(' · ')}` } }));
      root.hidden = true;
      document.dispatchEvent(new CustomEvent('ngt:mission-open'));
      if (smoke) { smoke.classList.add('is-clear'); setTimeout(() => smoke.remove(), 1200); }
      track('quiz_open', { tour: picked.id });
    });

    // "Ask again" (on the mission scroll) brings the quiz back to question one
    const resetQuiz = () => {
      root.hidden = false;
      result.classList.remove('is-poof', 'is-untie');
      result.hidden = true;
      root.classList.remove('is-sealed');
      box.classList.remove('is-done');
      ask.classList.remove('is-leaving');
      nod.hidden = true;
      ninja.classList.remove('is-in', 'is-nod');
      hist.length = 0;
      clearFrom(0);
      Object.keys(answers).forEach((k) => delete answers[k]);
      status.textContent = '';
      picked = null;
      busy = false;
      go(0);
    };
    speak('lord');
    const seen = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { type(qs[0]?.querySelector<HTMLElement>('[data-type]')); seen.disconnect(); } }), { threshold: 0.4 });
    seen.observe(box);
    document.addEventListener('ngt:mission-reset', () => {
      resetQuiz();
      requestAnimationFrame(() => root.scrollIntoView({ behavior: 'instant', block: 'start' }));
    });
    // links to #quiz (e.g. "Let the scroll decide") bring it back if it has turned into the mission scroll
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a[href="#quiz"]');
      if (a && root.hidden) { e.preventDefault(); document.dispatchEvent(new CustomEvent('ngt:mission-reset')); }
    });

    qs.forEach((q, i) => q.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.qz__opt');
      if (!b || busy) return;
      busy = true;
      const key = q.dataset.qzQ!;
      answers[key] = b.dataset.v!;
      labels[key] = b.dataset.label!;
      q.querySelectorAll('.qz__opt').forEach((o) => o.classList.toggle('is-picked', o === b));
      const next = advance(i);
      await sayNod(key, next < 0);
      if (next >= 0) { nod.hidden = true; hist.push(i); go(next); busy = false; }
      else reveal();
    }));

    back.addEventListener('click', () => {
      if (!hist.length || busy) return;
      const j = hist.pop()!;
      clearFrom(j);
      nod.hidden = true;
      go(j);
    });

  });
</script>

<style>
  /* Needs JS to work, so it only appears when scripts run */
  .qz { display: none; }
  :global(.js) .qz { display: block; }
  .qz { --gold: #e7c465; --floor: 76px; color: var(--ai); padding: 84px 0 var(--floor); overflow: clip; border-top: 1px solid rgb(31 45 82 / 0.12);
    /* aged print paper, the same tone as the illustrations, lighter where the questions are */
    background: radial-gradient(ellipse 55% 60% at 50% 45%, rgb(255 246 224 / 0.42), transparent 72%), #d2b27f var(--washi); }
  .qz .eyebrow { color: var(--ai); }
  .qz__in { display: grid; grid-template-columns: minmax(0, 330px) minmax(0, 1fr) minmax(0, 300px); grid-template-areas: 'lord head ninja' 'lord box ninja'; gap: 26px 24px; align-items: start; }
  .qz__head { grid-area: head; position: relative; z-index: 2; }
  .qz__box { grid-area: box; z-index: 2; }
  .qz__head h2 { font-size: clamp(2.6rem, 5.2vw, 4.4rem); line-height: 0.95; margin: 0 0 12px; }
  .qz__o { color: transparent; -webkit-text-stroke: 2px var(--ai); }


  /* ---- The stage: the Lord and your Ninja, big, standing on the floor of the section ---- */
  .qz__fig { position: relative; margin: 0 0 calc(var(--floor) * -1); align-self: end; z-index: 1; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 16%), linear-gradient(to right, transparent, #000 13%, #000 87%, transparent);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(to bottom, transparent, #000 16%), linear-gradient(to right, transparent, #000 13%, #000 87%, transparent); mask-composite: intersect; }
  /* the actors flank the stage, full height, spilling past the page margins */
  .qz__fig--lord { grid-area: lord; width: calc(100% + 70px); margin-left: -70px; }
  .qz__fig--ninja { grid-area: ninja; width: calc(100% + 70px); margin-right: -70px; justify-self: end; }
  .qz__fig-pic { display: block; transform-origin: 50% 100%; animation: qz-breathe 5s ease-in-out infinite alternate; }
  .qz__fig img { display: block; width: 100%; height: auto; transform-origin: 50% 90%; }
  /* the name slip, like the title cartouche on a print */
  .qz__fig-name { position: absolute; top: 22%; writing-mode: vertical-rl; font-family: var(--mincho); font-weight: 800; font-size: 1.5rem; line-height: 1; padding: 8px 5px; background: var(--cream); color: var(--ai); border: 2px solid var(--ai); box-shadow: 3px 3px 0 var(--ai); }
  .qz__fig--lord .qz__fig-name { left: 14%; }
  .qz__fig--ninja .qz__fig-name { right: 14%; background: #14151f; color: var(--cream); border-color: #14151f; box-shadow: 3px 3px 0 rgb(0 0 0 / 0.5); }
  @keyframes qz-breathe { from { transform: none; } to { transform: scale(1.012) translateY(-2px); } }
  /* the Lord leans in when he asks */
