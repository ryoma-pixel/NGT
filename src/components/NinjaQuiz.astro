    .qz__in { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'head' 'stage' 'box'; gap: 0; }
    .qz__head { display: block; margin-bottom: 8px; }
    .qz__floor { display: block; grid-area: stage; align-self: end; position: relative; z-index: 0; height: 26px; margin: 0 -16px;
      background: repeating-linear-gradient(90deg, rgb(0 0 0 / 0.2) 0 2px, transparent 2px 78px), linear-gradient(180deg, #a06a36, #7a4c22 70%, #5e3a1a); box-shadow: inset 0 3px 0 rgb(255 226 170 / 0.35), 0 -10px 18px -8px rgb(60 30 5 / 0.35); }
    .qz__fig { grid-area: stage; align-self: end; width: 56%; height: 58vw; margin: 0; overflow: hidden;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 82%, transparent), linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 82%, transparent), linear-gradient(to right, transparent, #000 10%, #000 90%, transparent); }
    .qz__fig--lord { justify-self: start; margin-left: -16px; }
    .qz__fig--ninja { justify-self: end; margin-right: -16px; }
    .qz__fig-pic, .qz__fig--ninja .qz__fig-pic, .qz__fig--ninja.is-in .qz__fig-pic { opacity: 1; transform: none; transition: opacity 0.35s, transform 0.45s cubic-bezier(.3,1.4,.5,1); animation: none; }
    /* the one not speaking steps back into the shade */
    .qz[data-speaker='ninja'] .qz__fig--lord .qz__fig-pic, .qz[data-speaker='lord'] .qz__fig--ninja .qz__fig-pic { opacity: 0.42; transform: translateY(8px) scale(0.96); }
    .qz__fig-name { top: 16%; font-size: 0.95rem; padding: 5px 3px; }
    .qz__fig--lord .qz__fig-name { left: 18%; }
    .qz__fig--ninja .qz__fig-name { right: 18%; }
    .qz__fig-smoke { bottom: 30%; }
    /* dialogue window over the edge of the stage */
    .qz__box { margin-top: -14px; }
    .qz__ask { position: relative; }
    .qz__q { width: 100%; box-sizing: border-box; min-height: 104px; }
    .qz__q .qz__say { font-size: 1.5rem; }
    .qz__decree .qz__say { font-size: 1.3rem; }
    /* your Ninja's reply takes over the same window */
    .qz__nod { top: 38px; }
    .qz__nod .qz__say--ninja { font-size: 1.2rem; }
    .qz__back { top: 2px; }
        .qz__ask { min-height: 0; }
    .qz__opts { grid-template-columns: 1fr 1fr; }
    .qz__opt { flex-direction: column; align-items: flex-start; min-height: 100px; font-size: 1.15rem; padding: 14px; }
    .qz__q { padding-right: 0; padding-top: 34px; }
    .qz__scroll { height: 390px; }
    .qz__seal-scroll { width: 124px; margin-left: -62px; height: 360px; top: 15px; }
    .qz__slip-jp { font-size: 1.7rem; }
