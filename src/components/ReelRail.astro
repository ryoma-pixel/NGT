---
// Guest reels from Instagram. Only a cover image loads with the page; the Instagram player loads when someone taps play.
import { srcset } from '../lib/img';
import type { Reel } from '../lib/reels';
interface Props { reels: Reel[] }
const { reels } = Astro.props;
---
<div class="rl" data-reels>
  <ul class="rl__list">
    {reels.map((r) => (
      <li>
        <button type="button" class="rl__card" data-reel={r.code} data-track="play_reel" data-reel-title={r.title} aria-label={`Play the Instagram reel: ${r.title}`}>
          <img src={r.cover} srcset={srcset(r.cover, 1400)} sizes="(max-width: 700px) 60vw, 260px" alt="" loading="lazy" decoding="async" width="360" height="640" />
          <span class="rl__shade" aria-hidden="true"></span>
          <span class="rl__ig" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg> Reel</span>
          <span class="rl__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
          <span class="rl__t">{r.title}{r.tourTitle && <small>{r.tourTitle}</small>}</span>
        </button>
      </li>
    ))}
  </ul>
  <dialog class="rl__dlg" aria-label="Instagram reel">
    <div class="rl__frame" data-reel-frame></div>
    <div class="rl__bar">
      <a class="rl__open" data-reel-open href="#" target="_blank" rel="noopener">Open in Instagram ↗</a>
      <button type="button" class="rl__close" data-reel-close>Close ✕</button>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-reels]').forEach((root) => {
    const dlg = root.querySelector<HTMLDialogElement>('dialog')!;
    const frame = root.querySelector<HTMLElement>('[data-reel-frame]')!;
    const open = root.querySelector<HTMLAnchorElement>('[data-reel-open]')!;
    root.querySelectorAll<HTMLButtonElement>('[data-reel]').forEach((b) =>
      b.addEventListener('click', () => {
        const code = b.dataset.reel!;
        const f = document.createElement('iframe');
        f.src = `https://www.instagram.com/p/${code}/embed/`;
        f.title = `Instagram reel: ${b.dataset.reelTitle ?? ''}`;
        f.allow = 'autoplay; encrypted-media; picture-in-picture';
        f.loading = 'eager';
        frame.replaceChildren(f);
        open.href = `https://www.instagram.com/p/${code}/`;
        dlg.showModal();
      }),
    );
    const close = () => { dlg.close(); };
    root.querySelector('[data-reel-close]')!.addEventListener('click', close);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.addEventListener('close', () => frame.replaceChildren());
  });
</script>

<style>
  .rl__list { list-style: none; margin: 0; padding: 4px 0 16px; display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .rl__list::-webkit-scrollbar { display: none; }
  .rl__list li { flex: none; width: min(60vw, 260px); scroll-snap-align: start; }
  .rl__card { position: relative; display: block; width: 100%; aspect-ratio: 9 / 16; padding: 0; border: 0; border-radius: 6px; overflow: hidden; cursor: pointer; background: var(--night-2); color: #fff; text-align: left; box-shadow: var(--shadow); }
  .rl__card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s cubic-bezier(.2,.7,.2,1); }
  .rl__card:hover img, .rl__card:focus-visible img { transform: scale(1.05); }
  .rl__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 8 20 / 0.35), transparent 30%, transparent 55%, rgb(10 8 20 / 0.85)); }
  .rl__ig { position: absolute; top: 12px; left: 12px; display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-weight: 700; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .rl__play { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; display: grid; place-items: center; background: rgb(247 240 227 / 0.92); color: var(--night); box-shadow: 0 8px 24px rgb(0 0 0 / 0.4); transition: transform 0.3s; }
  .rl__card:hover .rl__play { transform: scale(1.08); }
  .rl__t { position: absolute; left: 14px; right: 14px; bottom: 14px; font-family: var(--display); font-size: 1.35rem; line-height: 1; text-transform: uppercase; }
  .rl__t small { display: block; margin-top: 6px; font-family: var(--mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; opacity: 0.85; }
  .rl__dlg { padding: 0; border: 0; background: transparent; width: min(420px, 94vw); max-height: 94vh; overflow: visible; }
  .rl__dlg::backdrop { background: rgb(8 8 18 / 0.85); }
  .rl__frame { background: #fff; border-radius: 8px; overflow: hidden; height: min(78vh, 740px); }
  .rl__frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .rl__bar { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; font-family: var(--mono); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; }
  .rl__open { color: var(--cream); }
  .rl__close { background: none; border: 1.5px solid var(--cream); color: var(--cream); font: inherit; padding: 6px 12px; border-radius: 4px; cursor: pointer; }
</style>
