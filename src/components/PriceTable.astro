---
// Price by party size, written out the way guests asked for it:
// how many adults → what each pays → what the booking costs in total.
// `big` is the home page version; the tour page booking box uses the compact one.
import pricing from '../data/pricing.json';
import { priceTiers, tierTotal, yen, type Tour } from '../lib/tours';
import Usd from './Usd.astro';
interface Props { tour?: Tour; big?: boolean; notes?: string[] }
const { tour, big = false, notes = [] } = Astro.props;
const tiers = tour ? priceTiers(tour) : pricing.tiers;
const last = tiers.length - 1;
---
<div class:list={['pt', { 'pt--big': big }]}>
  <table class="pt__table">
    <caption class="visually-hidden">Price by the number of adults in your booking</caption>
    <thead><tr><th scope="col">Adults in your booking</th><th scope="col">Per person</th><th scope="col">Total</th></tr></thead>
    <tbody>
      {tiers.map((t, i) => {
        const open = t.maxGuests > t.minGuests;
        return (
          <tr class:list={{ 'pt__best': i === last && last > 0 }}>
            <th scope="row">
              <span class="pt__ppl" aria-hidden="true">
                {Array.from({ length: t.minGuests }, () => <svg viewBox="0 0 20 24" width="20" height="24"><circle cx="10" cy="6" r="5" /><path d="M1 24c0-6.5 4-10 9-10s9 3.5 9 10z" /></svg>)}
                {open && <b>+</b>}
              </span>
              <span class="pt__who">{t.label}</span>
              {i === last && last > 0 && <span class="pt__tag">Best value</span>}
            </th>
            <td><strong>{yen(t.pricePerPerson)}</strong><Usd jpy={t.pricePerPerson} class="pt__usd" /></td>
            <td>
              <strong>{tierTotal(t)}</strong>
              {open && <span class="pt__eg">e.g. {t.minGuests} adults: {yen(t.pricePerPerson * t.minGuests)}</span>}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
  <p class="pt__kids">
    <svg viewBox="0 0 20 24" width="28" height="34" aria-hidden="true"><circle cx="10" cy="8" r="4.5" /><path d="M3 24c0-5 3-8 7-8s7 3 7 8z" /></svg>
    <span><strong>Kids 12 and under: FREE</strong><span class="pt__kids-sub">With a paying adult, as many as you bring.</span></span>
  </p>
  <ul class="pt__notes">
    <li>{pricing.note}</li>
    {notes.map((n) => <li>{n}</li>)}
  </ul>
</div>

<style>
  .pt__table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .pt__table thead th { font-family: var(--mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); text-align: left; padding: 0 0.5em 0.6em; border-bottom: 2px solid var(--ai); }
  .pt__table th, .pt__table td { padding: 0.7em 0.5em; border-bottom: 1px solid var(--line); text-align: left; vertical-align: middle; }
  .pt__table tbody th { font-weight: 400; }
  .pt__table td:last-child, .pt__table th:last-child, .pt__table thead th:last-child { text-align: right; }
  .pt__table strong { display: block; font-size: 1.1rem; line-height: 1.2; color: var(--ink); }
  .pt__ppl { display: flex; align-items: flex-end; gap: 1px; color: var(--ai); margin-bottom: 3px; }
  .pt__ppl svg { width: 11px; height: auto; fill: currentColor; }
  .pt__ppl b { font-size: 0.85rem; line-height: 1; margin-left: 2px; }
  .pt__who { display: block; font-weight: 700; }
  .pt__tag { display: inline-block; margin-top: 4px; font-family: var(--mono); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; background: var(--ai); color: var(--cream); padding: 2px 7px; border-radius: 999px; }
  .pt__best th, .pt__best td { background: #f6e7bd; }
  .pt__best th { box-shadow: inset 4px 0 0 #c99a2e; }
  .pt :global(.pt__usd) { display: block; font-size: 0.72rem; color: var(--muted); }
  .pt__eg { display: block; font-size: 0.72rem; color: var(--muted); }
  .pt__kids { display: flex; align-items: center; gap: 12px; margin: 16px 0 0; padding: 12px 16px; background: var(--ai); color: var(--cream); border-radius: 12px; }
  .pt__kids svg { flex: none; fill: currentColor; }
  .pt__kids strong { display: block; font-family: var(--display); font-weight: 400; font-size: 1.45rem; line-height: 1.1; letter-spacing: 0.01em; }
  .pt__kids-sub { display: block; font-size: 0.8rem; opacity: 0.85; }
  .pt__notes { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 3px; font-size: 0.75rem; line-height: 1.5; color: var(--muted); }
  .pt__notes li::before { content: '※ '; }

  /* Home page: a larger board */
  .pt--big { max-width: 880px; margin: 36px auto 20px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: clamp(18px, 3vw, 32px); }
  .pt--big .pt__table thead th { font-size: 0.75rem; }
  .pt--big .pt__table th, .pt--big .pt__table td { padding: 0.9em 0.8em; }
  .pt--big .pt__table strong { font-family: var(--display); font-weight: 400; font-size: clamp(1.5rem, 3.4vw, 2.3rem); letter-spacing: 0.01em; }
  .pt--big .pt__ppl svg { width: 16px; }
  .pt--big .pt__who { font-size: 1.05rem; }
  .pt--big .pt__kids { margin-top: 22px; padding: 16px 22px; gap: 16px; }
  .pt--big .pt__kids strong { font-size: clamp(1.8rem, 4.4vw, 2.6rem); }
  .pt--big .pt__kids-sub { font-size: 0.9rem; }
  .pt--big .pt__notes { font-size: 0.8rem; margin-top: 14px; }
  @media (max-width: 560px) {
    .pt--big .pt__table th, .pt--big .pt__table td { padding: 0.75em 0.35em; }
    .pt--big .pt__table thead th { font-size: 0.62rem; }
  }
</style>
